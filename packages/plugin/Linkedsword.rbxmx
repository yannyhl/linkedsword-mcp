		position = UDim2.new(0.5, -35, 0.5, 20),
		color = Color3.fromRGB(60, 60, 68),
		transparency = 0.6,
		cornerRadius = UDim.new(1, 0),
	})

	p.body = createMascotPart({
		name = "Body", parent = parent,
		size = UDim2.new(0, 60, 0, 28),
		position = UDim2.new(0.5, -30, 0.5, 2),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 14),
	})

	p.head = createMascotPart({
		name = "Head", parent = parent,
		size = UDim2.new(0, 34, 0, 34),
		position = UDim2.new(0.5, -17, 0.5, -24),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(1, 0),
	})

	p.leftEar = createMascotPart({
		name = "LeftEar", parent = p.head,
		size = UDim2.new(0, 10, 0, 10),
		position = UDim2.new(0, 2, 0, -6),
		rotation = -20,
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 3),
	})

	p.rightEar = createMascotPart({
		name = "RightEar", parent = p.head,
		size = UDim2.new(0, 10, 0, 10),
		position = UDim2.new(0, 22, 0, -6),
		rotation = 20,
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 3),
	})

	p.leftEarInner = createMascotPart({
		name = "LeftEarInner", parent = p.leftEar,
		size = UDim2.new(0, 5, 0, 5),
		position = UDim2.new(0.5, -2, 0.5, -2),
		color = rgbFromTable(th.catEarInner),
		cornerRadius = UDim.new(0, 2),
	})

	p.rightEarInner = createMascotPart({
		name = "RightEarInner", parent = p.rightEar,
		size = UDim2.new(0, 5, 0, 5),
		position = UDim2.new(0.5, -3, 0.5, -2),
		color = rgbFromTable(th.catEarInner),
		cornerRadius = UDim.new(0, 2),
	})

	p.leftEye = createMascotPart({
		name = "LeftEye", parent = p.head,
		size = UDim2.new(0, 10, 0, 2),
		position = UDim2.new(0, 6, 0, 16),
		color = rgbFromTable(th.catEye),
	})

	p.rightEye = createMascotPart({
		name = "RightEye", parent = p.head,
		size = UDim2.new(0, 10, 0, 2),
		position = UDim2.new(0, 18, 0, 16),
		color = rgbFromTable(th.catEye),
	})

	p.tail = createMascotPart({
		name = "Tail", parent = parent,
		size = UDim2.new(0, 6, 0, 18),
		position = UDim2.new(0.5, 30, 0.5, -4),
		rotation = 20,
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 3),
	})

	-- Sword (Classic Linked Sword)
	p.swordContainer = createMascotPart({
		name = "Sword", parent = parent,
		size = UDim2.new(0, 30, 0, 50),
		position = UDim2.new(0.5, -48, 0.5, -10),
		transparency = 1,
	})

	p.swordBladeGlow = createMascotPart({
		name = "BladeGlow", parent = p.swordContainer,
		size = UDim2.new(0, 10, 0, 28),
		position = UDim2.new(0.5, -5, 0, 1),
		color = rgbFromTable(th.accent),
		transparency = 0.6,
		cornerRadius = UDim.new(0, 3),
	})

	p.swordBlade = createMascotPart({
		name = "Blade", parent = p.swordContainer,
		size = UDim2.new(0, 6, 0, 30),
		position = UDim2.new(0.5, -3, 0, 0),
		color = rgbFromTable(th.accent),
		cornerRadius = UDim.new(0, 2),
	})

	p.swordCrossguard = createMascotPart({
		name = "Crossguard", parent = p.swordContainer,
		size = UDim2.new(0, 14, 0, 4),
		position = UDim2.new(0.5, -7, 0, 28),
		color = rgbFromTable(th.swordGuard),
		cornerRadius = UDim.new(0, 1),
	})

	p.swordGrip = createMascotPart({
		name = "Grip", parent = p.swordContainer,
		size = UDim2.new(0, 4, 0, 12),
		position = UDim2.new(0.5, -2, 0, 31),
		color = rgbFromTable(th.swordGrip),
		cornerRadius = UDim.new(0, 1),
	})

	p.swordPommel = createMascotPart({
		name = "Pommel", parent = p.swordContainer,
		size = UDim2.new(0, 6, 0, 6),
		position = UDim2.new(0.5, -3, 0, 42),
		color = rgbFromTable(th.swordGuard),
		cornerRadius = UDim.new(1, 0),
	})

	-- Z labels (sleep indicators)
	p.zLabels = {}
	p.zConfigs = {
		{ text = "z", size = 12, offsetX = 22, offsetY = -26 },
		{ text = "z", size = 16, offsetX = 30, offsetY = -34 },
		{ text = "Z", size = 20, offsetX = 24, offsetY = -44 },
