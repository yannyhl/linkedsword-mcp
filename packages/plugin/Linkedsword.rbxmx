serverInput.Text = serverUrl
serverInput.PlaceholderText = "http://127.0.0.1:3002"
serverInput.PlaceholderColor3 = rgbFromTable(theme.textSecondary)
serverInput.TextColor3 = rgbFromTable(theme.textPrimary)
serverInput.TextSize = 12
serverInput.Font = Enum.Font.Code
serverInput.TextXAlignment = Enum.TextXAlignment.Left
serverInput.ClearTextOnFocus = false
