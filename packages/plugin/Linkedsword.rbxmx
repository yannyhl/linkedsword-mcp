local testBtn = Instance.new("TextButton")
testBtn.Name = "TestBtn"
testBtn.Size = UDim2.new(0, 36, 0, 20)
testBtn.Position = UDim2.new(1, -40, 0.5, -10)
testBtn.BackgroundColor3 = rgbFromTable(theme.cardBg)
testBtn.TextColor3 = rgbFromTable(theme.textSecondary)
testBtn.Text = "Test"
testBtn.TextSize = 10
testBtn.Font = Enum.Font.GothamMedium
testBtn.BorderSizePixel = 0
testBtn.Parent = serverInputFrame
Instance.new("UICorner", testBtn).CornerRadius = UDim.new(0, 4)

testBtn.Activated:Connect(function()
	testBtn.Text = "..."
	local testUrl = serverInput.Text
	if not testUrl or #testUrl == 0 then testUrl = serverUrl end
	local ok, result = pcall(function()
		return HttpService:GetAsync(testUrl .. "/health")
	end)
	if ok then
		local decodeOk, data = pcall(function() return HttpService:JSONDecode(result) end)
		if decodeOk and data then
			showToast("Server reachable — v" .. (data.version or "?") .. ", " .. (data.instances or 0) .. " instance(s)", "success")
			testBtn.Text = "✓"
			testBtn.TextColor3 = rgbFromTable(theme.success)
		else
			showToast("Server responded with invalid data", "error")
			testBtn.Text = "✗"
			testBtn.TextColor3 = rgbFromTable(theme.error)
		end
	else
		showToast("Server unreachable at " .. testUrl, "error")
		testBtn.Text = "✗"
		testBtn.TextColor3 = rgbFromTable(theme.error)
	end
	task.delay(2, function()
		testBtn.Text = "Test"
		testBtn.TextColor3 = rgbFromTable(theme.textSecondary)
	end)
end)

serverInput.Focused:Connect(function()
	serverInputStroke.Color = rgbFromTable(theme.accent)
end)

serverInput.FocusLost:Connect(function()
	serverInputStroke.Color = rgbFromTable(theme.muted)
	local newUrl = serverInput.Text
	if newUrl and #newUrl > 0 then serverUrl = newUrl else serverInput.Text = serverUrl end
end)

