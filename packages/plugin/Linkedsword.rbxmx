detailLayout.SortOrder = Enum.SortOrder.LayoutOrder
detailLayout.Padding = UDim.new(0, 1)
detailLayout.Parent = statusDetails

local function createDetailRow(name: string, text: string, order: number): TextLabel
	local row = Instance.new("TextLabel")
	row.Name = name
	row.Size = UDim2.new(1, 0, 0, 14)
	row.BackgroundTransparency = 1
	row.Text = text
	row.TextColor3 = rgbFromTable(theme.textSecondary)
	row.TextSize = 10
	row.Font = Enum.Font.Code
	row.TextXAlignment = Enum.TextXAlignment.Left
	row.LayoutOrder = order
	row.Parent = statusDetails
	return row
end

local bridgeRow = createDetailRow("Bridge", "HTTP Bridge: Disconnected", 0)
local serverRow = createDetailRow("Server", "Server: --", 1)
local modeRow = createDetailRow("Mode", "Mode: --", 2)
local toolsRow = createDetailRow("Tools", "Tools: --", 3)

local function updateLatencyBadge()
	if not connected then
		latencyBadge.Visible = false
		return
	end
	latencyBadge.Visible = true
	latencyBadge.Text = lastLatencyMs .. "ms"
	if lastLatencyMs < 200 then
		latencyBadge.TextColor3 = rgbFromTable(theme.success)
	elseif lastLatencyMs < 1000 then
		latencyBadge.TextColor3 = rgbFromTable(theme.warning)
	else
		latencyBadge.TextColor3 = rgbFromTable(theme.error)
	end
end

local function updateStatusDetails()
	statusDetails.Visible = connected
	bridgeRow.Text = "HTTP Bridge: " .. (if connected then "Connected" else "Disconnected")
	if lastHeartbeatData then
		serverRow.Text = "Server: v" .. (lastHeartbeatData.serverVersion or "?")
		local m = lastHeartbeatData.mode or currentMode or "full"
		modeRow.Text = "Mode: " .. string.upper(string.sub(m, 1, 1)) .. string.sub(m, 2)
	end
	updateLatencyBadge()
end

