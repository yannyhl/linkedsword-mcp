local function updateConnectButton()
	if running then
		connectButton.Text = "Disconnect"
		connectButton.BackgroundColor3 = rgbFromTable(theme.inputBg)
		connectButton.TextColor3 = rgbFromTable(theme.error)
		connectStroke.Color = rgbFromTable(theme.error)
	else
		connectButton.Text = "Connect"
		connectButton.BackgroundColor3 = rgbFromTable(theme.success)
		connectButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		connectStroke.Color = rgbFromTable(theme.border)
	end
	serverInput.TextEditable = not running
end

