-- ============================================================================
-- Utility Functions (declared before handlers so no forward-reference issues)
-- ============================================================================

-- Stable-ID index: ls://<uuid> → Instance (in-memory cache)
-- Persisted alongside the instance as an `LSStableId` attribute so it survives
-- save/reopen; the index is rebuilt lazily as resolve_stable_id queries arrive.
local stableIdIndex: { [string]: Instance } = {}

local function findInstanceByStableId(id: string): Instance?
	local cached = stableIdIndex[id]
	if cached and cached.Parent then return cached end
	-- Cache miss or stale: scan descendants until we find the matching attribute.
	-- Bounded by the size of the DataModel; this is the slow path.
	for _, inst in game:GetDescendants() do
		if inst:GetAttribute("LSStableId") == id then
			stableIdIndex[id] = inst
			return inst
		end
	end
	stableIdIndex[id] = nil
	return nil
end

local function resolveInstance(path: string?): Instance?
	if not path then return nil end
	if string.sub(path, 1, 5) == "ls://" then
		return findInstanceByStableId(string.sub(path, 6))
	end
	local current: Instance = game
	for _, segment in string.split(path, ".") do
		if segment == "game" then continue end
		local child = current:FindFirstChild(segment)
		if not child then return nil end
		current = child
	end
	return current
end

local function getInstancePath(inst: Instance): string
	local parts = {}
	local current = inst
	while current and current ~= game do
		table.insert(parts, 1, current.Name)
		current = current.Parent
	end
	return "game." .. table.concat(parts, ".")
end

local function convertValue(val: any, propertyHint: string?): any
	if type(val) == "table" then
		if propertyHint and (
			string.find(propertyHint, "Color") or
			propertyHint == "BackgroundColor3" or
			propertyHint == "TextColor3"
		) then
			if #val == 3 then
				if val[1] > 1 or val[2] > 1 or val[3] > 1 then
					return Color3.fromRGB(val[1], val[2], val[3])
				else
					return Color3.new(val[1], val[2], val[3])
				end
			end
		end
		if #val == 3 then
			return Vector3.new(val[1], val[2], val[3])
		elseif #val == 2 then
			return Vector2.new(val[1], val[2])
		elseif #val == 4 then
			return UDim2.new(val[1], val[2], val[3], val[4])
		elseif #val == 12 then
			return CFrame.new(val[1], val[2], val[3], val[4], val[5], val[6], val[7], val[8], val[9], val[10], val[11], val[12])
		end
	end
	if val == "true" then return true end
	if val == "false" then return false end
	-- BrickColor from string
	if type(val) == "string" and propertyHint == "BrickColor" then
		local ok, bc = pcall(BrickColor.new, val)
		if ok then return bc end
	end
	-- Enum from string (e.g. Material = "Plastic")
	if type(val) == "string" and propertyHint then
		local ok, enumVal = pcall(function()
			return (Enum :: any)[propertyHint] and (Enum :: any)[propertyHint][val]
		end)
		if ok and enumVal then return enumVal end
	end
	-- NumberRange from table {min, max}
	if type(val) == "table" and #val == 2 and propertyHint and string.find(propertyHint, "Range") then
		return NumberRange.new(val[1], val[2])
	end
	return val
end

local function executeLuau(code: string): { success: boolean, data: any? }
	local output = {}
	local wrapped = [[
		local __output = ...
		local function print(...)
			local args = { ... }
			local strs = {}
			for _, v in args do table.insert(strs, tostring(v)) end
			table.insert(__output, table.concat(strs, "\t"))
		end
		local function warn(...)
			local args = { ... }
			local strs = {}
			for _, v in args do table.insert(strs, tostring(v)) end
			table.insert(__output, "[WARN] " .. table.concat(strs, "\t"))
		end
	]] .. code

	local fn, compileErr = loadstring(wrapped)
	if not fn then
		return { success = false, error = "Compile error: " .. tostring(compileErr) }
	end
	local ok, runtimeErr = pcall(fn, output)
	if not ok then
		return { success = false, error = "Runtime error: " .. tostring(runtimeErr), data = { output = table.concat(output, "\n") } }
	end
	return { success = true, data = { output = table.concat(output, "\n") } }
end

-- ============================================================================
-- Mascot Registry — modular mascot skin system
-- ============================================================================

local MascotRegistry = {}

-- Shared helpers for drawing mascot parts
local function createMascotPart(props: any): Frame
	local f = Instance.new("Frame")
	f.Name = props.name or "Part"
	f.Size = props.size
	f.Position = props.position
	f.BackgroundColor3 = props.color or Color3.fromRGB(82, 82, 91)
	f.BackgroundTransparency = props.transparency or 0
	f.BorderSizePixel = 0
	f.Rotation = props.rotation or 0
	if props.zindex then f.ZIndex = props.zindex end
	f.Parent = props.parent
	if props.cornerRadius then
		Instance.new("UICorner", f).CornerRadius = props.cornerRadius
	end
	return f
end

local function createMascotLabel(props: any): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = props.name or "Label"
	l.Size = props.size
	l.Position = props.position
	l.BackgroundTransparency = 1
	l.Text = props.text
	l.TextColor3 = props.color or Color3.fromRGB(180, 140, 255)
	l.TextSize = props.textSize or 12
	l.Font = props.font or Enum.Font.GothamBold
	l.TextTransparency = props.transparency or 1
	l.Visible = if props.visible ~= nil then props.visible else true
	l.Parent = props.parent
	return l
end

-- Active mascot state (set when a skin is loaded)
local currentMascotParts = nil :: any
local currentMascotStop = nil :: (() -> ())?
local currentMascotSkin = nil :: string?

-- ============================================================================
