local consoleLogConnection = LogService.MessageOut:Connect(function(message, messageType)
	table.insert(consoleLogs, {
		type = if messageType == Enum.MessageType.MessageError then "error"
			elseif messageType == Enum.MessageType.MessageWarning then "warning"
			else "output",
		message = message,
		timestamp = os.clock(),
	})
	if #consoleLogs > MAX_CONSOLE_LOGS then table.remove(consoleLogs, 1) end
end)

