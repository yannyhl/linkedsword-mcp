		color = rgbFromTable(th.error),
		textSize = 18,
		visible = false,
	})

	-- Sparkles
	p.sparkles = {}
	p.sparklePositions = {
		UDim2.new(0.5, -38, 0.5, -20), UDim2.new(0.5, 38, 0.5, -14),
		UDim2.new(0.5, -32, 0.5, 14), UDim2.new(0.5, 42, 0.5, 6),
	}
	for i, pos in ipairs(p.sparklePositions) do
		p.sparkles[i] = createMascotLabel({
			name = "Sparkle" .. i, parent = parent,
			size = UDim2.new(0, 14, 0, 14),
			position = pos,
			text = if i % 2 == 0 then "\226\152\133" else "\226\156\166",
			color = rgbFromTable(th.sparkle),
			textSize = if i % 2 == 0 then 10 else 8,
		})
	end

	-- State label
	p.stateLabel = createMascotLabel({
		name = "StateLabel", parent = parent,
		size = UDim2.new(1, 0, 0, 16),
		position = UDim2.new(0, 0, 1, -16),
		text = "idle",
		color = Color3.fromRGB(82, 82, 91),
		textSize = 10,
		font = Enum.Font.Code,
		transparency = 0,
	})

	return p
end

function MascotRegistry.cat.animate(parts: any, getState: () -> string, isRunning: () -> boolean, widgetRef: any): () -> ()
	local alive = true
	local p = parts

	-- Body breathing / hopping
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.body, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Size = UDim2.new(0, 68, 0, 34), Position = UDim2.new(0.5, -34, 0.5, -1) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.body, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Size = UDim2.new(0, 60, 0, 28), Position = UDim2.new(0.5, -30, 0.5, 2) })
				t:Play(); t.Completed:Wait()
			elseif st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.body, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -30, 0.5, -5) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.body, TweenInfo.new(0.22, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -30, 0.5, 2) })
				t:Play(); t.Completed:Wait(); task.wait(0.25)
			else task.wait(1) end
		end
	end)

	-- Head nodding / bobbing
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.head, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -17, 0.5, -28) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.head, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, -17, 0.5, -24) })
				t:Play(); t.Completed:Wait(); task.wait(0.3)
			elseif st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.head, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0.5, -17, 0.5, -22) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.head, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0.5, -17, 0.5, -24) })
				t:Play(); t.Completed:Wait()
			else task.wait(1) end
		end
	end)

	-- Tail swaying
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.tail, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -15 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.tail, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 35 })
				t:Play(); t.Completed:Wait()
			elseif st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.tail, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 5 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.tail, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 30 })
				t:Play(); t.Completed:Wait()
			elseif st == "error" then
				local t = TweenService:Create(p.tail, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 55 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.tail, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 65 })
				t:Play(); t.Completed:Wait(); task.wait(1.5)
			else task.wait(1) end
		end
	end)

	-- Sword animation (container position/rotation + blade glow in one loop to avoid conflicts)
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.swordContainer, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -5, Position = UDim2.new(0.5, -48, 0.5, -11) })
				t:Play()
				TweenService:Create(p.swordBladeGlow, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.6, Size = UDim2.new(0, 10, 0, 28) }):Play()
				t.Completed:Wait()
				t = TweenService:Create(p.swordContainer, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 5, Position = UDim2.new(0.5, -48, 0.5, -9) })
				t:Play()
				TweenService:Create(p.swordBladeGlow, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.75, Size = UDim2.new(0, 10, 0, 28) }):Play()
				t.Completed:Wait()
			elseif st == "active" or st == "playtesting" then
				p.swordContainer.Position = UDim2.new(0.5, -50, 0.5, -12)
				local t = TweenService:Create(p.swordContainer, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 60, Position = UDim2.new(0.5, -44, 0.5, -14) })
				t:Play()
				TweenService:Create(p.swordBladeGlow, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.3, Size = UDim2.new(0, 14, 0, 32) }):Play()
				t.Completed:Wait()
				t = TweenService:Create(p.swordContainer, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Rotation = -30, Position = UDim2.new(0.5, -50, 0.5, -10) })
				t:Play()
				TweenService:Create(p.swordBladeGlow, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.6, Size = UDim2.new(0, 10, 0, 28) }):Play()
				t.Completed:Wait()
				task.wait(0.3)
			elseif st == "error" then
				local t = TweenService:Create(p.swordContainer, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 70, Position = UDim2.new(0.5, -44, 0.5, 8) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.swordContainer, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 80, Position = UDim2.new(0.5, -44, 0.5, 8) })
				t:Play(); t.Completed:Wait()
				p.swordBladeGlow.BackgroundTransparency = 0.85
			else task.wait(1) end
		end
	end)

	-- Z labels floating
	for zIndex, zl in ipairs(p.zLabels) do
		task.spawn(function()
			local staggerDelay = (zIndex - 1) * 0.8
			local cfg = p.zConfigs[zIndex]
			local startY = cfg.offsetY
			local floatDistance = 20 + (zIndex * 4)
			while alive and (isRunning() or getState() ~= "") do
				if not widgetRef.Parent then break end
				if getState() == "idle" or getState() == "disconnected" then
					task.wait(staggerDelay)
					if not alive then break end
					zl.Position = UDim2.new(0.5, cfg.offsetX, 0.5, startY); zl.TextTransparency = 0.2
					local t = TweenService:Create(zl, TweenInfo.new(2.0 + zIndex * 0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0.5, cfg.offsetX + (zIndex * 2), 0.5, startY - floatDistance), TextTransparency = 1 })
					t:Play(); t.Completed:Wait()
					if not alive then break end
					zl.Position = UDim2.new(0.5, cfg.offsetX, 0.5, startY); task.wait(0.2)
				else zl.TextTransparency = 1; task.wait(0.5) end
			end
		end)
	end

	-- Sparkles
	for spIndex, sp in ipairs(p.sparkles) do
		task.spawn(function()
			local basePos = p.sparklePositions[spIndex]
			local stagger = (spIndex - 1) * 0.4
			while alive and (isRunning() or getState() ~= "") do
				if not widgetRef.Parent then break end
				if getState() == "active" or getState() == "playtesting" then
					task.wait(stagger)
					if not alive then break end
					sp.Position = basePos; sp.TextTransparency = 0.3
					sp.TextSize = if spIndex % 2 == 0 then 10 else 8
					local t = TweenService:Create(sp, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { TextTransparency = 0, TextSize = if spIndex % 2 == 0 then 14 else 11 })
					t:Play(); t.Completed:Wait()
					if not alive then break end
					t = TweenService:Create(sp, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { TextTransparency = 1, Position = UDim2.new(basePos.X.Scale, basePos.X.Offset, basePos.Y.Scale, basePos.Y.Offset - 10) })
					t:Play(); t.Completed:Wait(); if not alive then break end; sp.Position = basePos; task.wait(0.5 + spIndex * 0.2)
				else sp.TextTransparency = 1; task.wait(0.5) end
			end
		end)
	end

	-- Error bang
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			if getState() == "error" then
				p.errorBang.Visible = true
				local t = TweenService:Create(p.errorBang, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { TextTransparency = 0, TextSize = 22 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.errorBang, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { TextTransparency = 0.3, TextSize = 16 })
				t:Play(); t.Completed:Wait(); task.wait(0.3)
			else p.errorBang.Visible = false; p.errorBang.TextTransparency = 1; task.wait(0.5) end
		end
	end)

	-- Glow pulse
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.glow, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.35, Size = UDim2.new(0, 76, 0, 16) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.glow, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.6, Size = UDim2.new(0, 70, 0, 14) })
				t:Play(); t.Completed:Wait()
			elseif st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.glow, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.5 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.glow, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.7 })
				t:Play(); t.Completed:Wait()
			else task.wait(1) end
		end
	end)

	return function() alive = false end
end

function MascotRegistry.cat.updateState(parts: any, state: string, th: any)
	local p = parts
	local catColor = state == "active" and rgbFromTable(th.accent)
		or state == "playtesting" and rgbFromTable(th.success)
		or state == "error" and rgbFromTable(th.error)
		or rgbFromTable(th.catBody)
	p.body.BackgroundColor3 = catColor
	p.head.BackgroundColor3 = catColor
	p.leftEar.BackgroundColor3 = catColor
	p.rightEar.BackgroundColor3 = catColor
	p.tail.BackgroundColor3 = catColor

	if state == "active" then
		p.glow.BackgroundColor3 = Color3.fromRGB(90, 50, 160)
		p.glow.BackgroundTransparency = 0.5
	elseif state == "error" then
		p.glow.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
		p.glow.BackgroundTransparency = 0.5
	else
		p.glow.BackgroundColor3 = Color3.fromRGB(60, 60, 68)
		p.glow.BackgroundTransparency = 0.6
	end

	p.errorBang.Visible = (state == "error")
	p.errorBang.TextTransparency = if state == "error" then 0 else 1

	if state == "error" then
		p.tail.Rotation = 60
		p.tail.Position = UDim2.new(0.5, 30, 0.5, 4)
	else
		p.tail.Rotation = 20
		p.tail.Position = UDim2.new(0.5, 30, 0.5, -4)
	end

	if state == "active" or state == "playtesting" then
		p.leftEye.Size = UDim2.new(0, 6, 0, 6)
		p.rightEye.Size = UDim2.new(0, 6, 0, 6)
		p.leftEye.Position = UDim2.new(0, 8, 0, 13)
		p.rightEye.Position = UDim2.new(0, 20, 0, 13)
		local ecL = p.leftEye:FindFirstChild("Corner") or Instance.new("UICorner")
		ecL.Name = "Corner"; ecL.CornerRadius = UDim.new(1, 0); ecL.Parent = p.leftEye
		local ecR = p.rightEye:FindFirstChild("Corner") or Instance.new("UICorner")
		ecR.Name = "Corner"; ecR.CornerRadius = UDim.new(1, 0); ecR.Parent = p.rightEye
		for _, zl in ipairs(p.zLabels) do zl.Visible = false end
	else
		p.leftEye.Size = UDim2.new(0, 10, 0, 2)
		p.rightEye.Size = UDim2.new(0, 10, 0, 2)
		p.leftEye.Position = UDim2.new(0, 6, 0, 16)
		p.rightEye.Position = UDim2.new(0, 18, 0, 16)
		local showZ = (state == "idle" or state == "disconnected")
		for _, zl in ipairs(p.zLabels) do zl.Visible = showZ end
	end

	for _, sp in ipairs(p.sparkles) do
		sp.Visible = (state == "active" or state == "playtesting")
		if not sp.Visible then sp.TextTransparency = 1 end
	end

	-- Sword state
	p.swordBlade.BackgroundColor3 = rgbFromTable(th.accent)
	p.swordBladeGlow.BackgroundColor3 = rgbFromTable(th.accent)
	p.swordCrossguard.BackgroundColor3 = rgbFromTable(th.swordGuard)
	p.swordPommel.BackgroundColor3 = rgbFromTable(th.swordGuard)
	p.swordGrip.BackgroundColor3 = rgbFromTable(th.swordGrip)

	if state == "error" then
		p.swordContainer.Rotation = 75
		p.swordContainer.Position = UDim2.new(0.5, -44, 0.5, 8)
		p.swordBladeGlow.BackgroundTransparency = 0.85
	elseif state == "active" or state == "playtesting" then
		p.swordContainer.Position = UDim2.new(0.5, -50, 0.5, -12)
	else
		p.swordContainer.Rotation = 0
		p.swordContainer.Position = UDim2.new(0.5, -48, 0.5, -10)
		p.swordBladeGlow.BackgroundTransparency = 0.6
	end

	p.stateLabel.Text = state
end

-- ============================================================================
-- Robot Mascot
-- ============================================================================

MascotRegistry.robot = {}

function MascotRegistry.robot.draw(parent: Frame, th: any): any
	local p = {}

	p.glow = createMascotPart({
		name = "Glow", parent = parent,
		size = UDim2.new(0, 66, 0, 12),
		position = UDim2.new(0.5, -33, 0.5, 24),
		color = Color3.fromRGB(60, 60, 68),
		transparency = 0.6,
		cornerRadius = UDim.new(1, 0),
	})

	-- Antenna
	p.antennaPole = createMascotPart({
		name = "AntennaPole", parent = parent,
		size = UDim2.new(0, 4, 0, 12),
		position = UDim2.new(0.5, -2, 0.5, -42),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 1),
	})

	p.antennaLight = createMascotPart({
		name = "AntennaLight", parent = parent,
		size = UDim2.new(0, 6, 0, 6),
		position = UDim2.new(0.5, -3, 0.5, -47),
		color = rgbFromTable(th.accent),
		cornerRadius = UDim.new(1, 0),
	})

	-- Head (square with rounded corners)
	p.head = createMascotPart({
		name = "Head", parent = parent,
		size = UDim2.new(0, 30, 0, 30),
		position = UDim2.new(0.5, -15, 0.5, -30),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 4),
	})

	-- Eyes (LED circles)
	p.leftEye = createMascotPart({
		name = "LeftEye", parent = p.head,
		size = UDim2.new(0, 8, 0, 8),
		position = UDim2.new(0, 4, 0, 8),
		color = rgbFromTable(th.catEye),
		cornerRadius = UDim.new(1, 0),
	})

	p.rightEye = createMascotPart({
		name = "RightEye", parent = p.head,
		size = UDim2.new(0, 8, 0, 8),
		position = UDim2.new(0, 18, 0, 8),
		color = rgbFromTable(th.catEye),
		cornerRadius = UDim.new(1, 0),
	})

	-- Mouth (small bar)
	p.mouth = createMascotPart({
		name = "Mouth", parent = p.head,
		size = UDim2.new(0, 12, 0, 2),
		position = UDim2.new(0.5, -6, 0, 22),
		color = rgbFromTable(th.catEye),
	})

	-- Body
	p.body = createMascotPart({
		name = "Body", parent = parent,
		size = UDim2.new(0, 50, 0, 30),
		position = UDim2.new(0.5, -25, 0.5, 0),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 4),
	})

	-- Screen/display on body
	p.screen = createMascotPart({
		name = "Screen", parent = p.body,
		size = UDim2.new(0, 40, 0, 14),
		position = UDim2.new(0.5, -20, 0.5, -7),
		color = rgbFromTable(th.accent),
		transparency = 0.3,
		cornerRadius = UDim.new(0, 2),
	})

	-- Arms
	p.leftArm = createMascotPart({
		name = "LeftArm", parent = parent,
		size = UDim2.new(0, 6, 0, 20),
		position = UDim2.new(0.5, -32, 0.5, 2),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 2),
	})

	p.rightArm = createMascotPart({
		name = "RightArm", parent = parent,
		size = UDim2.new(0, 6, 0, 20),
		position = UDim2.new(0.5, 26, 0.5, 2),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 2),
	})

	-- Legs
	p.leftLeg = createMascotPart({
		name = "LeftLeg", parent = parent,
		size = UDim2.new(0, 8, 0, 10),
		position = UDim2.new(0.5, -14, 0.5, 30),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 2),
	})

	p.rightLeg = createMascotPart({
		name = "RightLeg", parent = parent,
		size = UDim2.new(0, 8, 0, 10),
		position = UDim2.new(0.5, 6, 0.5, 30),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 2),
	})

	-- Signal waves (accessories for active state)
	p.signals = {}
	for i = 1, 3 do
		p.signals[i] = createMascotLabel({
			name = "Signal" .. i, parent = parent,
			size = UDim2.new(0, 12, 0, 12),
			position = UDim2.new(0.5, 18 + i * 6, 0.5, -44 + i * 2),
			text = ")",
			color = rgbFromTable(th.sparkle),
			textSize = 8 + i * 2,
		})
	end

	-- Gear icons (like sparkles for robot)
	p.gears = {}
	local gearPositions = {
		UDim2.new(0.5, -40, 0.5, -16), UDim2.new(0.5, 38, 0.5, -8),
		UDim2.new(0.5, -36, 0.5, 18), UDim2.new(0.5, 40, 0.5, 12),
	}
	for i, pos in ipairs(gearPositions) do
		p.gears[i] = createMascotLabel({
			name = "Gear" .. i, parent = parent,
			size = UDim2.new(0, 14, 0, 14),
			position = pos,
			text = if i % 2 == 0 then "\226\154\153" else "\226\154\161",
			color = rgbFromTable(th.sparkle),
			textSize = if i % 2 == 0 then 10 else 8,
		})
	end
	p.gearPositions = gearPositions

	-- Error sparks
	p.errorSpark = createMascotLabel({
		name = "ErrorSpark", parent = parent,
		size = UDim2.new(0, 16, 0, 16),
		position = UDim2.new(0.5, 18, 0.5, -36),
		text = "\226\154\161",
		color = rgbFromTable(th.error),
		textSize = 16,
		visible = false,
	})

	p.stateLabel = createMascotLabel({
		name = "StateLabel", parent = parent,
		size = UDim2.new(1, 0, 0, 16),
		position = UDim2.new(0, 0, 1, -16),
		text = "idle",
		color = Color3.fromRGB(82, 82, 91),
		textSize = 10,
		font = Enum.Font.Code,
		transparency = 0,
	})

	return p
end

function MascotRegistry.robot.animate(parts: any, getState: () -> string, isRunning: () -> boolean, widgetRef: any): () -> ()
	local alive = true
	local p = parts

	-- Body hover / bounce
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.body, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0.5, -25, 0.5, -2) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.body, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0.5, -25, 0.5, 2) })
				t:Play(); t.Completed:Wait()
			elseif st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.body, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -25, 0.5, -6) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.body, TweenInfo.new(0.2, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -25, 0.5, 0) })
				t:Play(); t.Completed:Wait(); task.wait(0.2)
			else task.wait(1) end
		end
	end)

	-- Head hover
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.head, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0.5, -15, 0.5, -32) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.head, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0.5, -15, 0.5, -30) })
				t:Play(); t.Completed:Wait()
			elseif st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.head, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -15, 0.5, -34) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.head, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, -15, 0.5, -30) })
				t:Play(); t.Completed:Wait(); task.wait(0.25)
			elseif st == "error" then
				local t = TweenService:Create(p.head, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 15 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.head, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 0 })
				t:Play(); t.Completed:Wait(); task.wait(1.5)
			else task.wait(1) end
		end
	end)

	-- Antenna LED blink
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.antennaLight, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.7 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.antennaLight, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0 })
				t:Play(); t.Completed:Wait()
			elseif st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.antennaLight, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.5 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.antennaLight, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0 })
				t:Play(); t.Completed:Wait()
			else task.wait(1) end
		end
	end)

	-- Arm swing
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.leftArm, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -15 })
				t:Play()
				local t2 = TweenService:Create(p.rightArm, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 15 })
				t2:Play(); t.Completed:Wait()
				t = TweenService:Create(p.leftArm, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 15 })
				t:Play()
				t2 = TweenService:Create(p.rightArm, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -15 })
				t2:Play(); t.Completed:Wait()
			else
				p.leftArm.Rotation = 0; p.rightArm.Rotation = 0; task.wait(0.5)
			end
		end
	end)

	-- Screen flicker
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.screen, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.1 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.screen, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.4 })
				t:Play(); t.Completed:Wait()
			elseif st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.screen, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.5 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.screen, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.3 })
				t:Play(); t.Completed:Wait()
			else task.wait(1) end
		end
	end)

	-- Gear sparkles (like cat sparkles)
	for gIdx, gear in ipairs(p.gears) do
		task.spawn(function()
			local basePos = p.gearPositions[gIdx]
			local stagger = (gIdx - 1) * 0.4
			while alive and (isRunning() or getState() ~= "") do
				if not widgetRef.Parent then break end
				if getState() == "active" or getState() == "playtesting" then
					task.wait(stagger)
					if not alive then break end
					gear.Position = basePos; gear.TextTransparency = 0.3
					local t = TweenService:Create(gear, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { TextTransparency = 0, TextSize = if gIdx % 2 == 0 then 14 else 11 })
					t:Play(); t.Completed:Wait()
					if not alive then break end
					t = TweenService:Create(gear, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { TextTransparency = 1, Position = UDim2.new(basePos.X.Scale, basePos.X.Offset, basePos.Y.Scale, basePos.Y.Offset - 10) })
					t:Play(); t.Completed:Wait(); if not alive then break end; gear.Position = basePos; task.wait(0.5 + gIdx * 0.2)
				else gear.TextTransparency = 1; task.wait(0.5) end
			end
		end)
	end

	-- Signal waves
	for sIdx, sig in ipairs(p.signals) do
		task.spawn(function()
			while alive and (isRunning() or getState() ~= "") do
				if not widgetRef.Parent then break end
				if getState() == "active" or getState() == "playtesting" then
					task.wait((sIdx - 1) * 0.3)
					if not alive then break end
					sig.TextTransparency = 0.2
					local t = TweenService:Create(sig, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { TextTransparency = 1 })
					t:Play(); t.Completed:Wait(); task.wait(0.3)
				else sig.TextTransparency = 1; task.wait(0.5) end
			end
		end)
	end

	-- Error spark
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			if getState() == "error" then
				p.errorSpark.Visible = true
				local t = TweenService:Create(p.errorSpark, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { TextTransparency = 0, TextSize = 20 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.errorSpark, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { TextTransparency = 0.5, TextSize = 14 })
				t:Play(); t.Completed:Wait(); task.wait(0.4)
			else p.errorSpark.Visible = false; p.errorSpark.TextTransparency = 1; task.wait(0.5) end
		end
	end)

	-- Glow
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.glow, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.35, Size = UDim2.new(0, 72, 0, 14) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.glow, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.6, Size = UDim2.new(0, 66, 0, 12) })
				t:Play(); t.Completed:Wait()
			elseif st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.glow, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.5 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.glow, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.7 })
				t:Play(); t.Completed:Wait()
			else task.wait(1) end
		end
	end)

	return function() alive = false end
end

function MascotRegistry.robot.updateState(parts: any, state: string, th: any)
	local p = parts
	local bodyColor = state == "active" and rgbFromTable(th.accent)
		or state == "playtesting" and rgbFromTable(th.success)
		or state == "error" and rgbFromTable(th.error)
		or rgbFromTable(th.catBody)
	p.body.BackgroundColor3 = bodyColor
	p.head.BackgroundColor3 = bodyColor
	p.leftArm.BackgroundColor3 = bodyColor
	p.rightArm.BackgroundColor3 = bodyColor
	p.leftLeg.BackgroundColor3 = bodyColor
	p.rightLeg.BackgroundColor3 = bodyColor
	p.antennaPole.BackgroundColor3 = bodyColor
	p.antennaLight.BackgroundColor3 = rgbFromTable(th.accent)
	p.screen.BackgroundColor3 = rgbFromTable(th.accent)
	p.mouth.BackgroundColor3 = rgbFromTable(th.catEye)
	p.leftEye.BackgroundColor3 = rgbFromTable(th.catEye)
	p.rightEye.BackgroundColor3 = rgbFromTable(th.catEye)

	if state == "active" then
		p.glow.BackgroundColor3 = Color3.fromRGB(90, 50, 160)
		p.glow.BackgroundTransparency = 0.5
	elseif state == "error" then
		p.glow.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
		p.glow.BackgroundTransparency = 0.5
		p.screen.BackgroundColor3 = rgbFromTable(th.error)
	else
		p.glow.BackgroundColor3 = Color3.fromRGB(60, 60, 68)
		p.glow.BackgroundTransparency = 0.6
	end

	p.errorSpark.Visible = (state == "error")

	for _, gear in ipairs(p.gears) do
		gear.Visible = (state == "active" or state == "playtesting")
		if not gear.Visible then gear.TextTransparency = 1 end
	end

	for _, sig in ipairs(p.signals) do
		sig.Visible = (state == "active" or state == "playtesting")
		if not sig.Visible then sig.TextTransparency = 1 end
	end

	p.stateLabel.Text = state
end

-- ============================================================================
-- Dog Mascot
-- ============================================================================

MascotRegistry.dog = {}

function MascotRegistry.dog.draw(parent: Frame, th: any): any
	local p = {}

	p.glow = createMascotPart({
		name = "Glow", parent = parent,
		size = UDim2.new(0, 72, 0, 14),
		position = UDim2.new(0.5, -36, 0.5, 22),
		color = Color3.fromRGB(60, 60, 68),
		transparency = 0.6,
		cornerRadius = UDim.new(1, 0),
	})

	p.body = createMascotPart({
		name = "Body", parent = parent,
		size = UDim2.new(0, 56, 0, 30),
		position = UDim2.new(0.5, -28, 0.5, 2),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 12),
	})

	p.head = createMascotPart({
		name = "Head", parent = parent,
		size = UDim2.new(0, 36, 0, 32),
		position = UDim2.new(0.5, -18, 0.5, -24),
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 10),
	})

	-- Floppy ears (hanging down, rotated outward)
	p.leftEar = createMascotPart({
		name = "LeftEar", parent = p.head,
		size = UDim2.new(0, 8, 0, 16),
		position = UDim2.new(0, -2, 0, 2),
		rotation = -10,
		color = rgbFromTable(th.catEarInner),
		cornerRadius = UDim.new(0, 4),
	})

	p.rightEar = createMascotPart({
		name = "RightEar", parent = p.head,
		size = UDim2.new(0, 8, 0, 16),
		position = UDim2.new(0, 30, 0, 2),
		rotation = 10,
		color = rgbFromTable(th.catEarInner),
		cornerRadius = UDim.new(0, 4),
	})

	-- Big round eyes
	p.leftEye = createMascotPart({
		name = "LeftEye", parent = p.head,
		size = UDim2.new(0, 8, 0, 8),
		position = UDim2.new(0, 6, 0, 8),
		color = rgbFromTable(th.catEye),
		cornerRadius = UDim.new(1, 0),
	})

	p.rightEye = createMascotPart({
		name = "RightEye", parent = p.head,
		size = UDim2.new(0, 8, 0, 8),
		position = UDim2.new(0, 22, 0, 8),
		color = rgbFromTable(th.catEye),
		cornerRadius = UDim.new(1, 0),
	})

	-- Nose
	p.nose = createMascotPart({
		name = "Nose", parent = p.head,
		size = UDim2.new(0, 6, 0, 4),
		position = UDim2.new(0.5, -3, 0, 18),
		color = Color3.fromRGB(40, 40, 45),
		cornerRadius = UDim.new(0, 2),
	})

	-- Tongue (visible when active)
	p.tongue = createMascotPart({
		name = "Tongue", parent = p.head,
		size = UDim2.new(0, 5, 0, 8),
		position = UDim2.new(0.5, -2, 0, 22),
		color = Color3.fromRGB(240, 120, 140),
		cornerRadius = UDim.new(0, 2),
		transparency = 1,
	})

	-- Tail (curving upward)
	p.tail = createMascotPart({
		name = "Tail", parent = parent,
		size = UDim2.new(0, 6, 0, 20),
		position = UDim2.new(0.5, 30, 0.5, -8),
		rotation = -30,
		color = rgbFromTable(th.catBody),
		cornerRadius = UDim.new(0, 3),
	})

	-- Paws
	p.paws = {}
	local pawPositions = {
		UDim2.new(0.5, -22, 0.5, 28),
		UDim2.new(0.5, -10, 0.5, 28),
		UDim2.new(0.5, 4, 0.5, 28),
		UDim2.new(0.5, 16, 0.5, 28),
	}
	for i, pos in ipairs(pawPositions) do
		p.paws[i] = createMascotPart({
			name = "Paw" .. i, parent = parent,
			size = UDim2.new(0, 8, 0, 6),
			position = pos,
			color = rgbFromTable(th.catBody),
			cornerRadius = UDim.new(0, 2),
		})
	end

	-- Hearts (instead of sparkles)
	p.hearts = {}
	p.heartPositions = {
		UDim2.new(0.5, -38, 0.5, -18), UDim2.new(0.5, 36, 0.5, -12),
		UDim2.new(0.5, -34, 0.5, 14), UDim2.new(0.5, 40, 0.5, 8),
	}
	for i, pos in ipairs(p.heartPositions) do
		p.hearts[i] = createMascotLabel({
			name = "Heart" .. i, parent = parent,
			size = UDim2.new(0, 14, 0, 14),
			position = pos,
			text = "\226\153\165",
			color = Color3.fromRGB(255, 100, 130),
			textSize = if i % 2 == 0 then 10 else 8,
		})
	end

	-- Bone Z's (instead of Z labels)
	p.bones = {}
	p.boneConfigs = {
		{ text = "\240\159\166\180", size = 10, offsetX = 24, offsetY = -28 },
		{ text = "\240\159\166\180", size = 13, offsetX = 32, offsetY = -36 },
		{ text = "\240\159\166\180", size = 16, offsetX = 26, offsetY = -46 },
	}
	for i, cfg in ipairs(p.boneConfigs) do
		p.bones[i] = createMascotLabel({
			name = "Bone" .. i, parent = parent,
			size = UDim2.new(0, 24, 0, 24),
			position = UDim2.new(0.5, cfg.offsetX, 0.5, cfg.offsetY),
			text = cfg.text,
			color = rgbFromTable(th.textSecondary),
			textSize = cfg.size,
		})
	end

	-- Error whimper
	p.errorWhimper = createMascotLabel({
		name = "ErrorWhimper", parent = parent,
		size = UDim2.new(0, 20, 0, 16),
		position = UDim2.new(0.5, 20, 0.5, -36),
		text = "...",
		color = rgbFromTable(th.error),
		textSize = 14,
		visible = false,
	})

	p.stateLabel = createMascotLabel({
		name = "StateLabel", parent = parent,
		size = UDim2.new(1, 0, 0, 16),
		position = UDim2.new(0, 0, 1, -16),
		text = "idle",
		color = Color3.fromRGB(82, 82, 91),
		textSize = 10,
		font = Enum.Font.Code,
		transparency = 0,
	})

	return p
end

function MascotRegistry.dog.animate(parts: any, getState: () -> string, isRunning: () -> boolean, widgetRef: any): () -> ()
	local alive = true
	local p = parts

	-- Body breathing / bouncing
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.body, TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Size = UDim2.new(0, 62, 0, 34), Position = UDim2.new(0.5, -31, 0.5, 0) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.body, TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Size = UDim2.new(0, 56, 0, 30), Position = UDim2.new(0.5, -28, 0.5, 2) })
				t:Play(); t.Completed:Wait()
			elseif st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.body, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -28, 0.5, -4) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.body, TweenInfo.new(0.15, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -28, 0.5, 2) })
				t:Play(); t.Completed:Wait(); task.wait(0.15)
			else task.wait(1) end
		end
	end)

	-- Head bobbing
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.head, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -18, 0.5, -28) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.head, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, -18, 0.5, -24) })
				t:Play(); t.Completed:Wait(); task.wait(0.2)
			elseif st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.head, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0.5, -18, 0.5, -22) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.head, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0.5, -18, 0.5, -24) })
				t:Play(); t.Completed:Wait()
			elseif st == "error" then
				local t = TweenService:Create(p.head, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -10 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.head, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 0 })
				t:Play(); t.Completed:Wait(); task.wait(1.0)
			else task.wait(1) end
		end
	end)

	-- Tail wagging
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.tail, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -50 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.tail, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 10 })
				t:Play(); t.Completed:Wait()
			elseif st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.tail, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -40 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.tail, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -20 })
				t:Play(); t.Completed:Wait()
			elseif st == "error" then
				local t = TweenService:Create(p.tail, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 40, Position = UDim2.new(0.5, 28, 0.5, 10) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.tail, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 50, Position = UDim2.new(0.5, 28, 0.5, 10) })
				t:Play(); t.Completed:Wait(); task.wait(1.5)
			else task.wait(1) end
		end
	end)

	-- Ear sway
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.leftEar, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -20 })
				t:Play()
				TweenService:Create(p.rightEar, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 20 }):Play()
				t.Completed:Wait()
				t = TweenService:Create(p.leftEar, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -5 })
				t:Play()
				TweenService:Create(p.rightEar, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 5 }):Play()
				t.Completed:Wait(); task.wait(0.2)
			elseif st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.leftEar, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -15 })
				t:Play()
				TweenService:Create(p.rightEar, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 15 }):Play()
				t.Completed:Wait()
				t = TweenService:Create(p.leftEar, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -5 })
				t:Play()
				TweenService:Create(p.rightEar, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = 5 }):Play()
				t.Completed:Wait()
			else task.wait(1) end
		end
	end)

	-- Tongue panting (visible in active)
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				p.tongue.BackgroundTransparency = 0
				local t = TweenService:Create(p.tongue, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Size = UDim2.new(0, 5, 0, 10) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.tongue, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Size = UDim2.new(0, 5, 0, 6) })
				t:Play(); t.Completed:Wait()
			else p.tongue.BackgroundTransparency = 1; task.wait(0.5) end
		end
	end)

	-- Bone floating (like Z labels)
	for bIdx, bone in ipairs(p.bones) do
		task.spawn(function()
			local stagger = (bIdx - 1) * 0.8
			local cfg = p.boneConfigs[bIdx]
			local startY = cfg.offsetY
			local floatDist = 18 + (bIdx * 4)
			while alive and (isRunning() or getState() ~= "") do
				if not widgetRef.Parent then break end
				if getState() == "idle" or getState() == "disconnected" then
					task.wait(stagger)
					if not alive then break end
					bone.Position = UDim2.new(0.5, cfg.offsetX, 0.5, startY); bone.TextTransparency = 0.2
					local t = TweenService:Create(bone, TweenInfo.new(2.0 + bIdx * 0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0.5, cfg.offsetX + (bIdx * 2), 0.5, startY - floatDist), TextTransparency = 1 })
					t:Play(); t.Completed:Wait()
					if not alive then break end
					bone.Position = UDim2.new(0.5, cfg.offsetX, 0.5, startY); task.wait(0.2)
				else bone.TextTransparency = 1; task.wait(0.5) end
			end
		end)
	end

	-- Hearts (like sparkles)
	for hIdx, heart in ipairs(p.hearts) do
		task.spawn(function()
			local basePos = p.heartPositions[hIdx]
			local stagger = (hIdx - 1) * 0.4
			while alive and (isRunning() or getState() ~= "") do
				if not widgetRef.Parent then break end
				if getState() == "active" or getState() == "playtesting" then
					task.wait(stagger)
					if not alive then break end
					heart.Position = basePos; heart.TextTransparency = 0.3
					local t = TweenService:Create(heart, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { TextTransparency = 0, TextSize = if hIdx % 2 == 0 then 14 else 11 })
					t:Play(); t.Completed:Wait()
					if not alive then break end
					t = TweenService:Create(heart, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { TextTransparency = 1, Position = UDim2.new(basePos.X.Scale, basePos.X.Offset, basePos.Y.Scale, basePos.Y.Offset - 12) })
					t:Play(); t.Completed:Wait(); if not alive then break end; heart.Position = basePos; task.wait(0.5 + hIdx * 0.2)
				else heart.TextTransparency = 1; task.wait(0.5) end
			end
		end)
	end

	-- Error whimper
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			if getState() == "error" then
				p.errorWhimper.Visible = true
				local t = TweenService:Create(p.errorWhimper, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { TextTransparency = 0 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.errorWhimper, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { TextTransparency = 0.5 })
				t:Play(); t.Completed:Wait(); task.wait(0.5)
			else p.errorWhimper.Visible = false; p.errorWhimper.TextTransparency = 1; task.wait(0.5) end
		end
	end)

	-- Glow
	task.spawn(function()
		while alive and (isRunning() or getState() ~= "") do
			if not widgetRef.Parent then break end
			local st = getState()
			if st == "active" or st == "playtesting" then
				local t = TweenService:Create(p.glow, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.35, Size = UDim2.new(0, 78, 0, 16) })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.glow, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.6, Size = UDim2.new(0, 72, 0, 14) })
				t:Play(); t.Completed:Wait()
			elseif st == "idle" or st == "disconnected" then
				local t = TweenService:Create(p.glow, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.5 })
				t:Play(); t.Completed:Wait()
				t = TweenService:Create(p.glow, TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.7 })
				t:Play(); t.Completed:Wait()
			else task.wait(1) end
		end
	end)

	return function() alive = false end
end

function MascotRegistry.dog.updateState(parts: any, state: string, th: any)
	local p = parts
	local bodyColor = state == "active" and rgbFromTable(th.accent)
		or state == "playtesting" and rgbFromTable(th.success)
		or state == "error" and rgbFromTable(th.error)
		or rgbFromTable(th.catBody)
	p.body.BackgroundColor3 = bodyColor
	p.head.BackgroundColor3 = bodyColor
	p.tail.BackgroundColor3 = bodyColor
	for _, paw in ipairs(p.paws) do paw.BackgroundColor3 = bodyColor end
	p.leftEar.BackgroundColor3 = rgbFromTable(th.catEarInner)
	p.rightEar.BackgroundColor3 = rgbFromTable(th.catEarInner)
	p.leftEye.BackgroundColor3 = rgbFromTable(th.catEye)
	p.rightEye.BackgroundColor3 = rgbFromTable(th.catEye)

	if state == "active" then
		p.glow.BackgroundColor3 = Color3.fromRGB(90, 50, 160)
		p.glow.BackgroundTransparency = 0.5
	elseif state == "error" then
		p.glow.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
		p.glow.BackgroundTransparency = 0.5
	else
		p.glow.BackgroundColor3 = Color3.fromRGB(60, 60, 68)
		p.glow.BackgroundTransparency = 0.6
	end

	p.errorWhimper.Visible = (state == "error")

	if state == "error" then
		p.tail.Rotation = 40
		p.tail.Position = UDim2.new(0.5, 28, 0.5, 10)
		p.leftEar.Rotation = -20
		p.rightEar.Rotation = 20
	else
		p.tail.Rotation = -30
		p.tail.Position = UDim2.new(0.5, 30, 0.5, -8)
		p.leftEar.Rotation = -10
		p.rightEar.Rotation = 10
	end

	p.tongue.BackgroundTransparency = if (state == "active" or state == "playtesting") then 0 else 1

	local showBones = (state == "idle" or state == "disconnected")
	for _, bone in ipairs(p.bones) do bone.Visible = showBones end

	for _, heart in ipairs(p.hearts) do
		heart.Visible = (state == "active" or state == "playtesting")
		if not heart.Visible then heart.TextTransparency = 1 end
	end

	p.stateLabel.Text = state
end

-- ============================================================================
-- Mascot Loader (switches between skins)
-- ============================================================================

local mascotFrame = nil :: Frame? -- forward declaration, assigned in UI section
local widget = nil :: any -- forward declaration, assigned in UI section
local updateStatus = nil :: ((string, string) -> ())? -- forward declaration
local showToast = nil :: ((string, string?) -> ())? -- forward declaration

local function loadMascot(skinName: string)
	-- Stop current animations
	if currentMascotStop then
		currentMascotStop()
		currentMascotStop = nil
	end

	-- Clear existing mascot children (except layout objects)
	if mascotFrame then
		for _, child in mascotFrame:GetChildren() do
			if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
				child:Destroy()
			end
		end
	end

	local skin = MascotRegistry[skinName]
	if not skin then skin = MascotRegistry.cat; skinName = "cat" end

	currentMascotSkin = skinName
	currentMascotParts = skin.draw(mascotFrame, theme)
	-- animate needs widget reference — we'll set it after widget is created
	return skinName
end

local function startMascotAnimations()
	if currentMascotParts and currentMascotSkin then
		local skin = MascotRegistry[currentMascotSkin]
		if skin then
			currentMascotStop = skin.animate(currentMascotParts, function() return pluginState end, function() return running end, widget)
		end
	end
end

local function httpGet(path: string): (boolean, any)
	local ok, result = pcall(function()
		return HttpService:GetAsync(serverUrl .. path)
	end)
	if ok then
		local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(result) end)
		if decodeOk then return true, decoded end
	end
	return false, result
end

local function httpPost(path: string, body: any): (boolean, any)
	local ok, result = pcall(function()
		return HttpService:PostAsync(
			serverUrl .. path,
			HttpService:JSONEncode(body),
			Enum.HttpContentType.ApplicationJson
		)
	end)
	if ok then
		local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(result) end)
		if decodeOk then return true, decoded end
	end
	return false, result
end

local function applyPartialDiff(diffData)
	local inst = resolveInstance(diffData.scriptPath)
	if not inst or not inst:IsA("LuaSourceContainer") then return nil end
	local oldSource = ScriptEditorService:GetEditorSource(inst)
	local oldLines = string.split(oldSource, "\n")
	local result = {}
	local oldIdx = 1
	for _, hunk in diffData.hunks do
		while oldIdx < hunk.startOld do
			table.insert(result, oldLines[oldIdx])
			oldIdx += 1
		end
		if hunk.status == "accepted" then
			for _, line in hunk.lines do
				if line.type == "add" or line.type == "ctx" then table.insert(result, line.content) end
				if line.type == "del" or line.type == "ctx" then oldIdx += 1 end
			end
		else
			for _, line in hunk.lines do
				if line.type == "del" or line.type == "ctx" then
					table.insert(result, oldLines[oldIdx])
					oldIdx += 1
				end
			end
		end
	end
	while oldIdx <= #oldLines do
		table.insert(result, oldLines[oldIdx])
		oldIdx += 1
	end
	return table.concat(result, "\n")
end

local function reconstructNewSource(diffData)
	local inst = resolveInstance(diffData.scriptPath)
	if not inst or not inst:IsA("LuaSourceContainer") then return nil end
	local oldSource = ScriptEditorService:GetEditorSource(inst)
	local oldLines = string.split(oldSource, "\n")
	local result = {}
	local oldIdx = 1
	for _, hunk in diffData.hunks do
		while oldIdx < hunk.startOld do
			table.insert(result, oldLines[oldIdx])
			oldIdx += 1
		end
		for _, line in hunk.lines do
			if line.type == "add" or line.type == "ctx" then table.insert(result, line.content) end
			if line.type == "del" or line.type == "ctx" then oldIdx += 1 end
		end
	end
	while oldIdx <= #oldLines do
		table.insert(result, oldLines[oldIdx])
		oldIdx += 1
	end
	return table.concat(result, "\n")
end

local function buildFullScriptLines(oldSource, hunks)
	local oldLines = string.split(oldSource, "\n")
	local result = {}
	local oldIdx = 1
	local newLineNum = 1

	for hunkIdx, hunk in hunks do
		while oldIdx < hunk.startOld do
			table.insert(result, {
				type = "plain",
				lineOld = oldIdx,
				lineNew = newLineNum,
				content = oldLines[oldIdx] or "",
				hunkIdx = nil,
			})
			oldIdx += 1
			newLineNum += 1
		end

		table.insert(result, { isHunkBoundary = true, hunkIdx = hunkIdx })

		for _, line in hunk.lines do
			table.insert(result, {
				type = line.type,
				lineOld = line.lineOld,
				lineNew = line.lineNew,
				content = line.content,
				hunkIdx = hunkIdx,
			})
			if line.type == "del" or line.type == "ctx" then
				oldIdx += 1
			end
			if line.type == "add" or line.type == "ctx" then
				newLineNum = (line.lineNew or newLineNum) + 1
			end
		end
	end

	while oldIdx <= #oldLines do
		table.insert(result, {
			type = "plain",
			lineOld = oldIdx,
			lineNew = newLineNum,
			content = oldLines[oldIdx] or "",
			hunkIdx = nil,
		})
		oldIdx += 1
		newLineNum += 1
	end

	return result
end

local function collapseFullScriptLines(displayLines, expandedRegions)
	local result = {}
	local plainRun = {}
	local plainStartIdx = nil

	local function flushPlainRun()
		if #plainRun <= 20 then
			for _, line in plainRun do
				table.insert(result, line)
			end
		else
			local regionKey = plainStartIdx
			if expandedRegions[regionKey] then
				for _, line in plainRun do
					table.insert(result, line)
				end
			else
				for i = 1, 5 do
					table.insert(result, plainRun[i])
				end
				table.insert(result, {
					isCollapsed = true,
					hiddenCount = #plainRun - 10,
					regionKey = regionKey,
				})
				for i = #plainRun - 4, #plainRun do
					table.insert(result, plainRun[i])
				end
			end
		end
		plainRun = {}
		plainStartIdx = nil
	end

	for i, entry in displayLines do
		if entry.type == "plain" then
			if plainStartIdx == nil then
				plainStartIdx = i
			end
			table.insert(plainRun, entry)
		else
			if #plainRun > 0 then
				flushPlainRun()
			end
			table.insert(result, entry)
		end
	end
	if #plainRun > 0 then
		flushPlainRun()
	end

	return result
end

local function archiveDiff(diffId, diffData)
	local addCount, delCount = 0, 0
	local acceptedCount, rejectedCount = 0, 0
	for _, hunk in diffData.hunks do
		for _, line in hunk.lines do
			if line.type == "add" then addCount += 1 end
			if line.type == "del" then delCount += 1 end
		end
		if hunk.status == "accepted" then acceptedCount += 1
		elseif hunk.status == "rejected" then rejectedCount += 1 end
	end

	local outcome = if rejectedCount == 0 then "accepted"
		elseif acceptedCount == 0 then "rejected"
		else "partial"

	-- Truncate oldSource for storage (cap at 100k chars)
	local storedOldSource = diffData.oldSource
	if storedOldSource and #storedOldSource > 100000 then
		storedOldSource = string.sub(storedOldSource, 1, 100000)
	end

	table.insert(diffHistory, {
		id = diffId,
		scriptPath = diffData.scriptPath or diffData.scriptName or "Unknown",
		scriptName = diffData.scriptName or "Script",
		hunks = diffData.hunks,
		oldSource = storedOldSource,
		timestamp = diffData.timestamp or os.time(),
		resolvedAt = os.time(),
		outcome = outcome,
		addCount = addCount,
		delCount = delCount,
	})

	-- Cap history at 20 entries
	while #diffHistory > 20 do
		table.remove(diffHistory, 1)
	end

	saveDiffHistory()
end

