-- Helper to create a toggle setting row
local function createToggleSetting(name: string, label: string, default: boolean, order: number, onChange: (boolean) -> ()): TextButton
	local row = Instance.new("Frame")
	row.Name = name
	row.Size = UDim2.new(1, 0, 0, 24)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.Parent = settingsSection

	local rowLabel = Instance.new("TextLabel")
	rowLabel.Size = UDim2.new(1, -50, 1, 0)
	rowLabel.BackgroundTransparency = 1
	rowLabel.Text = label
	rowLabel.TextColor3 = rgbFromTable(theme.textPrimary)
	rowLabel.TextSize = 11
	rowLabel.Font = Enum.Font.GothamMedium
	rowLabel.TextXAlignment = Enum.TextXAlignment.Left
	rowLabel.Parent = row

	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(0, 40, 0, 20)
	toggleBtn.Position = UDim2.new(1, -40, 0.5, -10)
	toggleBtn.BackgroundColor3 = if default then rgbFromTable(theme.success) else Color3.fromRGB(63, 63, 70)
	toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	toggleBtn.Text = if default then "ON" else "OFF"
	toggleBtn.TextSize = 9
	toggleBtn.Font = Enum.Font.GothamBold
	toggleBtn.BorderSizePixel = 0
	toggleBtn.Parent = row
	Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 10)

	local isOn = default
	toggleBtn.Activated:Connect(function()
		isOn = not isOn
		toggleBtn.Text = if isOn then "ON" else "OFF"
		toggleBtn.BackgroundColor3 = if isOn then rgbFromTable(theme.success) else Color3.fromRGB(63, 63, 70)
		onChange(isOn)
	end)

	return toggleBtn
end

-- Helper to create color setting row; returns a refresh(newValues) function
local colorSettingRefreshers = {} -- collected for reset button
local function createColorSetting(name: string, label: string, themeKey: string, order: number, onChange: ({ number }) -> ())
	local default = theme[themeKey]
	local row = Instance.new("Frame")
	row.Name = name
	row.Size = UDim2.new(1, 0, 0, 24)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.Parent = settingsSection

	local rowLabel = Instance.new("TextLabel")
	rowLabel.Size = UDim2.new(0, 90, 1, 0)
	rowLabel.BackgroundTransparency = 1
	rowLabel.Text = label
	rowLabel.TextColor3 = rgbFromTable(theme.textPrimary)
	rowLabel.TextSize = 10
	rowLabel.Font = Enum.Font.GothamMedium
	rowLabel.TextXAlignment = Enum.TextXAlignment.Left
	rowLabel.Parent = row

	-- Color preview swatch
	local swatch = Instance.new("Frame")
	swatch.Size = UDim2.new(0, 16, 0, 16)
	swatch.Position = UDim2.new(0, 92, 0.5, -8)
	swatch.BackgroundColor3 = rgbFromTable(default)
	swatch.Parent = row
	Instance.new("UICorner", swatch).CornerRadius = UDim.new(0, 3)

	-- RGB input
	local inputs = {}
	for i, ch in ipairs({ "R", "G", "B" }) do
		local input = Instance.new("TextBox")
		input.Size = UDim2.new(0, 32, 0, 18)
		input.Position = UDim2.new(0, 112 + (i - 1) * 36, 0.5, -9)
		input.BackgroundColor3 = Color3.fromRGB(24, 24, 27)
		input.TextColor3 = rgbFromTable(theme.textPrimary)
		input.PlaceholderText = ch
		input.Text = tostring(default[i])
		input.TextSize = 9
		input.Font = Enum.Font.Code
		input.BorderSizePixel = 0
		input.ClearTextOnFocus = true
		input.Parent = row
		Instance.new("UICorner", input).CornerRadius = UDim.new(0, 3)
		inputs[i] = input

		input.FocusLost:Connect(function()
			local val = tonumber(input.Text)
			if val then
				val = math.clamp(math.floor(val), 0, 255)
				input.Text = tostring(val)
				default[i] = val
				swatch.BackgroundColor3 = rgbFromTable(default)
				onChange(default)
			else
				input.Text = tostring(default[i])
			end
		end)
	end

	-- Refresh function: syncs UI to current theme[themeKey] after external changes (e.g., reset)
	local function refresh()
		default = theme[themeKey]
		swatch.BackgroundColor3 = rgbFromTable(default)
		for i, inp in ipairs(inputs) do
			inp.Text = tostring(default[i])
		end
	end
	table.insert(colorSettingRefreshers, refresh)
end

-- Helper to create a section header in settings
local function createSectionHeader(text: string, order: number)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 0, 18)
	lbl.BackgroundTransparency = 1
	lbl.Text = "\226\128\148 " .. text .. " \226\128\148"
	lbl.TextColor3 = rgbFromTable(theme.textSecondary)
	lbl.TextSize = 9
	lbl.Font = Enum.Font.GothamBold
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.LayoutOrder = order
	lbl.Parent = settingsSection
end

-- Helper to create a dropdown setting
local function createDropdownSetting(name: string, label: string, options: { string }, default: string, order: number, onChange: (string) -> ())
	local row = Instance.new("Frame")
	row.Name = name
	row.Size = UDim2.new(1, 0, 0, 24)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.Parent = settingsSection

	local rowLabel = Instance.new("TextLabel")
	rowLabel.Size = UDim2.new(1, -90, 1, 0)
	rowLabel.BackgroundTransparency = 1
	rowLabel.Text = label
	rowLabel.TextColor3 = rgbFromTable(theme.textPrimary)
	rowLabel.TextSize = 11
	rowLabel.Font = Enum.Font.GothamMedium
	rowLabel.TextXAlignment = Enum.TextXAlignment.Left
	rowLabel.Parent = row

	local dropBtn = Instance.new("TextButton")
	dropBtn.Size = UDim2.new(0, 80, 0, 20)
	dropBtn.Position = UDim2.new(1, -80, 0.5, -10)
	dropBtn.BackgroundColor3 = Color3.fromRGB(63, 63, 70)
	dropBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	dropBtn.Text = default:sub(1, 1):upper() .. default:sub(2)
	dropBtn.TextSize = 9
	dropBtn.Font = Enum.Font.GothamBold
	dropBtn.BorderSizePixel = 0
	dropBtn.Parent = row
	Instance.new("UICorner", dropBtn).CornerRadius = UDim.new(0, 6)

	local currentIdx = 1
	for i, opt in ipairs(options) do
		if opt == default then currentIdx = i; break end
	end

	dropBtn.Activated:Connect(function()
		currentIdx = currentIdx % #options + 1
		local selected = options[currentIdx]
		dropBtn.Text = selected:sub(1, 1):upper() .. selected:sub(2)
		onChange(selected)
	end)
end

-- refreshTheme: re-applies all theme-dependent colors globally
-- Note: some UI elements (feedScroll, feedLabel, feedStroke) are defined later in the file,
-- so we guard against nil to avoid errors when settings are changed during initialization.
local function refreshTheme()
	root.BackgroundColor3 = rgbFromTable(theme.background)
	logoLabel.TextColor3 = rgbFromTable(theme.accent)
	statusText.TextColor3 = rgbFromTable(theme.textPrimary)
	settingsHeader.TextColor3 = rgbFromTable(theme.textSecondary)
	-- Card backgrounds
	statusFrame.BackgroundColor3 = rgbFromTable(theme.cardBg)
	serverInputFrame.BackgroundColor3 = rgbFromTable(theme.inputBg)
	if feedScroll then feedScroll.BackgroundColor3 = rgbFromTable(theme.cardBg) end
	-- Section labels
	serverLabel.TextColor3 = rgbFromTable(theme.textSecondary)
	if feedLabel then feedLabel.TextColor3 = rgbFromTable(theme.textSecondary) end
	-- UIStroke borders
	statusStroke.Color = rgbFromTable(theme.border)
	serverInputStroke.Color = rgbFromTable(theme.muted)
	if feedStroke then feedStroke.Color = rgbFromTable(theme.border) end
	diffBtnStroke.Color = rgbFromTable(theme.accent)
	-- Button variants
	diffOpenBtn.BackgroundColor3 = rgbFromTable(theme.background)
	diffOpenBtn.TextColor3 = rgbFromTable(theme.accent)
	updateConnectButton()
	-- Re-apply mascot state with updated theme
	if currentMascotParts and currentMascotSkin then
		local skin = MascotRegistry[currentMascotSkin]
		if skin then skin.updateState(currentMascotParts, pluginState, theme) end
	end
	pcall(function() plugin:SetSetting("LSTheme", theme) end)
end

