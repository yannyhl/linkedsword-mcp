-- Phase 2: Instance Manipulation Tools
-- ============================================================================

handlers["set_selection"] = function(params)
	if not params or not params.paths then return { success = false, error = "Missing required parameter: paths" } end
	local instances = {}
	local notFound = {}
	for _, path in params.paths do
		local inst = resolveInstance(path)
		if inst then table.insert(instances, inst)
		else table.insert(notFound, path) end
	end
	Selection:Set(instances)
	return { success = true, data = { selected = #instances, notFound = notFound } }
end

handlers["clone_object"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Not found: " .. tostring(params.path) } end
	ChangeHistoryService:SetWaypoint("LS:clone " .. inst.Name)
	local clone = inst:Clone()
	if params.name then clone.Name = params.name end
	local parent = if params.parent then resolveInstance(params.parent) else inst.Parent
	if not parent then return { success = false, error = "Parent not found" } end
	clone.Parent = parent
	ChangeHistoryService:SetWaypoint("LS:cloned " .. clone.Name)
	return { success = true, data = { name = clone.Name, path = getInstancePath(clone), className = clone.ClassName } }
end

handlers["reparent_object"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Not found: " .. tostring(params.path) } end
	local newParent = resolveInstance(params.newParent)
	if not newParent then return { success = false, error = "New parent not found: " .. tostring(params.newParent) } end
	ChangeHistoryService:SetWaypoint("LS:reparent " .. inst.Name)
	local oldPath = getInstancePath(inst)
	inst.Parent = newParent
	ChangeHistoryService:SetWaypoint("LS:reparented " .. inst.Name)
	return { success = true, data = { name = inst.Name, oldPath = oldPath, newPath = getInstancePath(inst) } }
end

handlers["group_objects"] = function(params)
	if not params or not params.paths then return { success = false, error = "Missing required parameter: paths" } end
	local containerType = params.containerType or "Model"
	local instances = {}
	for _, path in params.paths do
		local inst = resolveInstance(path)
		if inst then table.insert(instances, inst) end
	end
	if #instances == 0 then return { success = false, error = "No valid instances found" } end
	ChangeHistoryService:SetWaypoint("LS:group objects")
	local group = Instance.new(containerType)
	group.Name = params.name or "Group"
	group.Parent = instances[1].Parent
	for _, inst in instances do inst.Parent = group end
	ChangeHistoryService:SetWaypoint("LS:grouped objects")
	return { success = true, data = { name = group.Name, path = getInstancePath(group), childCount = #instances } }
end

handlers["ungroup_objects"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Not found" } end
	ChangeHistoryService:SetWaypoint("LS:ungroup " .. inst.Name)
	local parent = inst.Parent
	local children = inst:GetChildren()
	local moved = {}
	for _, child in children do
		child.Parent = parent
		table.insert(moved, { name = child.Name, path = getInstancePath(child) })
	end
	inst:Destroy()
	ChangeHistoryService:SetWaypoint("LS:ungrouped")
	return { success = true, data = { moved = moved, count = #moved } }
end

-- ============================================================================
-- Phase 3: Attribute & Tag Write Tools
-- ============================================================================

handlers["set_attribute"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Not found" } end
	ChangeHistoryService:SetWaypoint("LS:set attribute " .. params.name)
	local val = convertValue(params.value, nil)
	inst:SetAttribute(params.name, val)
	ChangeHistoryService:SetWaypoint("LS:set attribute done")
	return { success = true, data = { name = params.name, value = tostring(val), type = typeof(val) } }
end

handlers["delete_attribute"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Not found" } end
	ChangeHistoryService:SetWaypoint("LS:delete attribute " .. params.name)
	inst:SetAttribute(params.name, nil)
	ChangeHistoryService:SetWaypoint("LS:deleted attribute")
	return { success = true, data = { message = "Deleted attribute: " .. params.name } }
end

handlers["add_tag"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Not found" } end
	ChangeHistoryService:SetWaypoint("LS:add tag " .. params.tag)
	CollectionService:AddTag(inst, params.tag)
	ChangeHistoryService:SetWaypoint("LS:added tag")
	return { success = true, data = { tag = params.tag, path = params.path } }
end

handlers["remove_tag"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Not found" } end
	ChangeHistoryService:SetWaypoint("LS:remove tag " .. params.tag)
	CollectionService:RemoveTag(inst, params.tag)
	ChangeHistoryService:SetWaypoint("LS:removed tag")
	return { success = true, data = { tag = params.tag, path = params.path } }
end

-- ============================================================================
-- Phase 4: Script Line-Editing Tools
-- ============================================================================

handlers["edit_script_lines"] = function(params)
	if not params or not params.path or not params.startLine or not params.endLine or not params.newContent then
		return { success = false, error = "Missing required parameters: path, startLine, endLine, newContent" }
	end
	local inst = resolveInstance(params.path)
	if not inst or not inst:IsA("LuaSourceContainer") then return { success = false, error = "Script not found" } end
	local source = ScriptEditorService:GetEditorSource(inst)
	local lines = string.split(source, "\n")
	local startLine = math.max(1, params.startLine)
	local endLine = math.min(#lines, params.endLine)
	local newLines = string.split(params.newContent, "\n")
	local result = {}
	for i = 1, startLine - 1 do table.insert(result, lines[i]) end
	for _, line in newLines do table.insert(result, line) end
	for i = endLine + 1, #lines do table.insert(result, lines[i]) end
	ChangeHistoryService:SetWaypoint("LS:edit lines " .. startLine .. "-" .. endLine)
	ScriptEditorService:UpdateSourceAsync(inst, function() return table.concat(result, "\n") end)
	ChangeHistoryService:SetWaypoint("LS:edited lines")
	return { success = true, data = { path = params.path, linesReplaced = endLine - startLine + 1, newLineCount = #newLines } }
end

handlers["insert_script_lines"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst or not inst:IsA("LuaSourceContainer") then return { success = false, error = "Script not found" } end
	local source = ScriptEditorService:GetEditorSource(inst)
	local lines = string.split(source, "\n")
	local afterLine = math.clamp(params.afterLine or 0, 0, #lines)
	local newLines = string.split(params.content, "\n")
	local result = {}
	for i = 1, afterLine do table.insert(result, lines[i]) end
	for _, line in newLines do table.insert(result, line) end
	for i = afterLine + 1, #lines do table.insert(result, lines[i]) end
	ChangeHistoryService:SetWaypoint("LS:insert lines after " .. afterLine)
	ScriptEditorService:UpdateSourceAsync(inst, function() return table.concat(result, "\n") end)
	ChangeHistoryService:SetWaypoint("LS:inserted lines")
	return { success = true, data = { path = params.path, insertedAfter = afterLine, linesInserted = #newLines } }
end

handlers["delete_script_lines"] = function(params)
	if not params or not params.path or not params.startLine or not params.endLine then
		return { success = false, error = "Missing required parameters: path, startLine, endLine" }
	end
	local inst = resolveInstance(params.path)
	if not inst or not inst:IsA("LuaSourceContainer") then return { success = false, error = "Script not found" } end
	local source = ScriptEditorService:GetEditorSource(inst)
	local lines = string.split(source, "\n")
	local startLine = math.max(1, params.startLine)
	local endLine = math.min(#lines, params.endLine)
	local result = {}
	for i = 1, startLine - 1 do table.insert(result, lines[i]) end
	for i = endLine + 1, #lines do table.insert(result, lines[i]) end
	ChangeHistoryService:SetWaypoint("LS:delete lines " .. startLine .. "-" .. endLine)
	ScriptEditorService:UpdateSourceAsync(inst, function() return table.concat(result, "\n") end)
	ChangeHistoryService:SetWaypoint("LS:deleted lines")
	return { success = true, data = { path = params.path, linesDeleted = endLine - startLine + 1 } }
end

-- ============================================================================
-- Phase 5: Spatial & Terrain Tools
-- ============================================================================

handlers["create_weld"] = function(params)
	local part0 = resolveInstance(params.part0)
	local part1 = resolveInstance(params.part1)
	if not part0 or not part0:IsA("BasePart") then return { success = false, error = "Part0 not found or not a BasePart" } end
	if not part1 or not part1:IsA("BasePart") then return { success = false, error = "Part1 not found or not a BasePart" } end
	ChangeHistoryService:SetWaypoint("LS:create weld")
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = part0
	weld.Part1 = part1
	weld.Parent = part0
	ChangeHistoryService:SetWaypoint("LS:created weld")
	return { success = true, data = { name = weld.Name, path = getInstancePath(weld) } }
end

handlers["get_bounding_box"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Not found" } end
	if inst:IsA("Model") then
		local cf, size = inst:GetBoundingBox()
		return { success = true, data = {
			center = { cf.Position.X, cf.Position.Y, cf.Position.Z },
			size = { size.X, size.Y, size.Z },
		}}
	elseif inst:IsA("BasePart") then
		return { success = true, data = {
			center = { inst.Position.X, inst.Position.Y, inst.Position.Z },
			size = { inst.Size.X, inst.Size.Y, inst.Size.Z },
		}}
	else
		return { success = false, error = "Instance has no bounding box (not a Model or BasePart)" }
	end
end

handlers["raycast"] = function(params)
	if not params or not params.origin or not params.direction then return { success = false, error = "Missing required parameters: origin, direction" } end
	local origin = Vector3.new(params.origin[1], params.origin[2], params.origin[3])
	local direction = Vector3.new(params.direction[1], params.direction[2], params.direction[3])
	local rayParams = RaycastParams.new()
	if params.filterType == "exclude" then
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
	elseif params.filterType == "include" then
		rayParams.FilterType = Enum.RaycastFilterType.Include
	end
	if params.filterPaths then
		local filterList = {}
		for _, path in params.filterPaths do
			local inst = resolveInstance(path)
			if inst then table.insert(filterList, inst) end
		end
		rayParams.FilterDescendantsInstances = filterList
	end
	local result = workspace:Raycast(origin, direction, rayParams)
	if result then
		return { success = true, data = {
			hit = true,
			instance = { name = result.Instance.Name, path = getInstancePath(result.Instance), className = result.Instance.ClassName },
			position = { result.Position.X, result.Position.Y, result.Position.Z },
			normal = { result.Normal.X, result.Normal.Y, result.Normal.Z },
			distance = result.Distance,
			material = tostring(result.Material),
		}}
	else
		return { success = true, data = { hit = false } }
	end
end

handlers["fill_terrain"] = function(params)
	if not params or not params.center or not params.size then return { success = false, error = "Missing required parameters: center, size" } end
	local center = Vector3.new(params.center[1], params.center[2], params.center[3])
	local size = Vector3.new(params.size[1], params.size[2], params.size[3])
	local materialName = params.material or "Grass"
	local material = Enum.Material[materialName]
	if not material then return { success = false, error = "Invalid material: " .. materialName } end
	ChangeHistoryService:SetWaypoint("LS:fill terrain")
	local region = Region3.new(center - size / 2, center + size / 2)
	workspace.Terrain:FillRegion(region:ExpandToGrid(4), 4, material)
	ChangeHistoryService:SetWaypoint("LS:filled terrain")
	return { success = true, data = { center = params.center, size = params.size, material = materialName } }
end

handlers["clear_terrain"] = function(params)
	if params and params.region and params.region.center and params.region.size then
		local center = Vector3.new(params.region.center[1], params.region.center[2], params.region.center[3])
		local size = Vector3.new(params.region.size[1], params.region.size[2], params.region.size[3])
		local region = Region3.new(center - size / 2, center + size / 2)
		ChangeHistoryService:SetWaypoint("LS:clear terrain region")
		workspace.Terrain:FillRegion(region:ExpandToGrid(4), 4, Enum.Material.Air)
		ChangeHistoryService:SetWaypoint("LS:cleared terrain region")
	else
		ChangeHistoryService:SetWaypoint("LS:clear all terrain")
		workspace.Terrain:Clear()
		ChangeHistoryService:SetWaypoint("LS:cleared all terrain")
	end
	return { success = true, data = { message = "Terrain cleared" } }
end

-- ============================================================================
-- Phase 6: Advanced Tools
-- ============================================================================

handlers["redo"] = function(params)
	local count = (params and params.count) or 1
	for _ = 1, count do ChangeHistoryService:Redo() end
	return { success = true, data = { message = "Redo " .. count .. " step(s)" } }
end

handlers["get_descendants"] = function(params)
	local rootPath = (params and params.path) or "game.Workspace"
	local root = resolveInstance(rootPath)
	if not root then return { success = false, error = "Not found: " .. rootPath } end
	local results = {}
	local maxDepth = (params and params.maxDepth) or -1
	local limit = (params and params.limit) or 500
	local className = params and params.className
	local namePattern = params and params.namePattern
	local function traverse(inst, depth, path)
		if #results >= limit then return end
		if maxDepth >= 0 and depth > maxDepth then return end
		local fullPath = path .. "." .. inst.Name
		local match = true
		if className and inst.ClassName ~= className then match = false end
		if namePattern and not string.find(inst.Name, namePattern, 1, true) then match = false end
		if match then table.insert(results, { name = inst.Name, path = fullPath, className = inst.ClassName }) end
		for _, child in inst:GetChildren() do traverse(child, depth + 1, fullPath) end
	end
	for _, child in root:GetChildren() do traverse(child, 1, rootPath) end
	return { success = true, data = { results = results, count = #results, truncated = #results >= limit } }
end

handlers["batch_operations"] = function(params)
	if not params.operations then return { success = false, error = "No operations provided" } end
	ChangeHistoryService:SetWaypoint("LS:batch start")
	local results = {}
	for i, op in params.operations do
		if op.tool == "batch_operations" then
			table.insert(results, { index = i, success = false, error = "Recursive batch_operations not allowed" })
			continue
		end
		local handler = handlers[op.tool]
		if not handler then
			table.insert(results, { index = i, success = false, error = "Unknown tool: " .. tostring(op.tool) })
		else
			local ok, result = pcall(handler, op.params or {})
			if ok then
				table.insert(results, { index = i, success = result.success, data = result.data, error = result.error })
			else
				table.insert(results, { index = i, success = false, error = "Handler error: " .. tostring(result) })
			end
		end
	end
	ChangeHistoryService:SetWaypoint("LS:batch done")
	local successCount = 0
	for _, r in results do if r.success then successCount += 1 end end
	return { success = true, data = { results = results, total = #results, succeeded = successCount, failed = #results - successCount } }
end

handlers["get_console_output"] = function(params)
	local since = (params and params.since) or 0
	local limit = (params and params.limit) or 100
	local typeFilter = params and params.type or "all"
	local filtered = {}
	for i = #consoleLogs, 1, -1 do
		if #filtered >= limit then break end
		local entry = consoleLogs[i]
		if entry.timestamp > since and (typeFilter == "all" or entry.type == typeFilter) then
			table.insert(filtered, 1, entry)
		end
	end
	return { success = true, data = { logs = filtered, total = #consoleLogs } }
end

-- ============================================================================
-- Stable Instance Handles (P1.1) — survive renames/reparents
-- ============================================================================

handlers["get_stable_id"] = function(params)
	if not params or not params.path then
		return { success = false, error = "Missing required parameter: path" }
	end
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found: " .. tostring(params.path) } end
	local existing = inst:GetAttribute("LSStableId")
	if type(existing) == "string" and existing ~= "" then
		stableIdIndex[existing] = inst
		return { success = true, data = { id = existing, path = getInstancePath(inst), reused = true } }
	end
	local id = HttpService:GenerateGUID(false)
	ChangeHistoryService:SetWaypoint("LS:tag stable id")
	inst:SetAttribute("LSStableId", id)
	ChangeHistoryService:SetWaypoint("LS:tagged stable id")
	stableIdIndex[id] = inst
	return { success = true, data = { id = id, path = getInstancePath(inst), reused = false } }
end

handlers["resolve_stable_id"] = function(params)
	if not params or not params.id then
		return { success = false, error = "Missing required parameter: id" }
	end
	local inst = findInstanceByStableId(params.id)
	if not inst then return { success = true, data = { exists = false } } end
	return { success = true, data = { exists = true, path = getInstancePath(inst), className = inst.ClassName, name = inst.Name } }
end

-- ============================================================================
-- compare_instances (P1.2)
-- ============================================================================

-- Serialize a property value into a comparable form. Returns nil for values we
-- can't safely diff (functions, threads, userdata that doesn't survive tostring).
local function serializeProperty(value: any): any
	local t = typeof(value)
	if t == "string" or t == "number" or t == "boolean" then return value end
	if t == "nil" then return nil end
	if t == "Color3" then return { r = value.R, g = value.G, b = value.B } end
	if t == "Vector3" then return { x = value.X, y = value.Y, z = value.Z } end
	if t == "Vector2" then return { x = value.X, y = value.Y } end
	if t == "UDim2" then return { sx = value.X.Scale, ox = value.X.Offset, sy = value.Y.Scale, oy = value.Y.Offset } end
	if t == "CFrame" then return { tostring(value) } end
	if t == "EnumItem" then return tostring(value) end
	if t == "Instance" then return getInstancePath(value) end
	return tostring(value)
end

local COMPARE_PROP_LIST = {
	"Name", "ClassName", "Parent", "Anchored", "CanCollide", "Transparency", "Material",
	"Size", "Position", "Orientation", "Color", "BrickColor", "Reflectance", "CastShadow",
	"Visible", "Text", "TextColor3", "BackgroundColor3", "BackgroundTransparency",
	"Value", "SourceAssetId", "Disabled", "RunContext",
}

local function snapshotProperties(inst: Instance, filter: { string }?): { [string]: any }
	local props: { [string]: any } = {}
	local list = filter or COMPARE_PROP_LIST
	for _, propName in list do
		local ok, val = pcall(function() return (inst :: any)[propName] end)
		if ok then props[propName] = serializeProperty(val) end
	end
	return props
end

local function deepEqual(a: any, b: any): boolean
	if a == b then return true end
	if type(a) ~= type(b) then return false end
	if type(a) ~= "table" then return false end
	for k, v in a do if not deepEqual(v, b[k]) then return false end end
	for k in b do if a[k] == nil then return false end end
	return true
end

local function compareSubtree(a: Instance, b: Instance, relPath: string, propFilter: { string }?, includeChildren: boolean, acc: { propertyDiffs: {}, childrenOnlyInA: { string }, childrenOnlyInB: { string }, countA: number, countB: number })
	acc.countA += 1
	acc.countB += 1
	local propsA = snapshotProperties(a, propFilter)
	local propsB = snapshotProperties(b, propFilter)
	local seen: { [string]: boolean } = {}
	for prop, valA in propsA do
		seen[prop] = true
		if not deepEqual(valA, propsB[prop]) then
			table.insert(acc.propertyDiffs, { path = relPath, prop = prop, valueA = valA, valueB = propsB[prop] })
		end
	end
	for prop, valB in propsB do
		if not seen[prop] and not deepEqual(propsA[prop], valB) then
			table.insert(acc.propertyDiffs, { path = relPath, prop = prop, valueA = propsA[prop], valueB = valB })
		end
	end
	if not includeChildren then return end
	local childrenA = a:GetChildren()
	local childrenB = b:GetChildren()
	local matched: { [number]: boolean } = {}
	for _, childA in childrenA do
		local match: Instance? = nil
		for i, childB in childrenB do
			if not matched[i] and childB.Name == childA.Name and childB.ClassName == childA.ClassName then
				match = childB
				matched[i] = true
				break
			end
		end
		if match then
			compareSubtree(childA, match, relPath .. "." .. childA.Name, propFilter, includeChildren, acc)
		else
			table.insert(acc.childrenOnlyInA, relPath .. "." .. childA.Name)
			acc.countA += 1
		end
	end
	for i, childB in childrenB do
		if not matched[i] then
			table.insert(acc.childrenOnlyInB, relPath .. "." .. childB.Name)
			acc.countB += 1
		end
	end
end

handlers["compare_instances"] = function(params)
	if not params or not params.pathA or not params.pathB then
		return { success = false, error = "Missing required parameters: pathA, pathB" }
	end
	local instA = resolveInstance(params.pathA)
	local instB = resolveInstance(params.pathB)
	if not instA then return { success = false, error = "Instance not found: " .. tostring(params.pathA) } end
	if not instB then return { success = false, error = "Instance not found: " .. tostring(params.pathB) } end
	local includeChildren = if params.includeChildren == nil then true else params.includeChildren
	local filter = params.propertyFilter
	local acc = { propertyDiffs = {}, childrenOnlyInA = {}, childrenOnlyInB = {}, countA = 0, countB = 0 }
	compareSubtree(instA, instB, instA.Name, filter, includeChildren, acc)
	return { success = true, data = acc }
end

-- ============================================================================
-- get_connected_instances (P1.3)
-- ============================================================================

-- Properties known to hold Instance references. Limited list keeps the scan fast.
local OUTGOING_REF_PROPS = {
	"Part0", "Part1", "Attachment0", "Attachment1", "RootPart", "PrimaryPart",
	"Adornee", "Value", "ObjectValue", "Target", "Attachment", "Object",
	"SoundGroup", "TextureID", "Image",
}

local function readRefProp(inst: Instance, propName: string): Instance?
	local ok, val = pcall(function() return (inst :: any)[propName] end)
	if not ok then return nil end
	if typeof(val) == "Instance" then return val end
	return nil
end

local function collectOutgoing(inst: Instance, results: {})
	for _, propName in OUTGOING_REF_PROPS do
		local target = readRefProp(inst, propName)
		if target then
			table.insert(results, {
				sourcePath = getInstancePath(inst),
				targetPath = getInstancePath(target),
				propertyName = propName,
				className = target.ClassName,
			})
		end
	end
end

handlers["get_connected_instances"] = function(params)
	if not params or not params.path then
		return { success = false, error = "Missing required parameter: path" }
	end
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found: " .. tostring(params.path) } end
	local direction = params.direction or "both"
	local results = {}
	local capped = false
	if direction == "outgoing" or direction == "both" then
		collectOutgoing(inst, results)
	end
	if direction == "incoming" or direction == "both" then
		for _, other in game:GetDescendants() do
			if other == inst then continue end
			if #results >= 100 then capped = true; break end
			for _, propName in OUTGOING_REF_PROPS do
				local target = readRefProp(other, propName)
				if target == inst then
					table.insert(results, {
						sourcePath = getInstancePath(other),
						targetPath = getInstancePath(inst),
						propertyName = propName,
						className = inst.ClassName,
					})
				end
			end
		end
	end
	return { success = true, data = { connections = results, capped = capped } }
end

-- ============================================================================
-- Planning Mode: snapshot_subtree + revert_subtree (P3.1)
-- ============================================================================

-- Properties worth capturing for a high-fidelity checkpoint. Richer than the
-- export_build set — covers physics, geometry, materials, light, GUI, scripts,
-- and ValueBase. Properties absent on a given class are silently skipped.
local SNAPSHOT_PROPS = {
	"Anchored", "CanCollide", "CanQuery", "CanTouch", "CastShadow", "Color",
	"Material", "Reflectance", "Size", "Position", "Orientation", "CFrame",
	"Transparency", "Shape", "TopSurface", "BottomSurface", "Massless",
	"CustomPhysicalProperties", "BrickColor", "Name",
	"Brightness", "Range", "Angle", "Face",
	"Visible", "Text", "TextColor3", "TextSize", "BackgroundColor3",
	"BackgroundTransparency", "BorderColor3", "BorderSizePixel", "Active",
	"Value", "Disabled", "RunContext", "SourceAssetId",
}

-- Type-aware property serializer. Returns a JSON-safe value that the
-- restore side can deserialize back to a Roblox type. Returns nil for
-- types we can't safely round-trip (functions, threads, exotic userdata).
local function serializePropValue(v: any): any
	local t = typeof(v)
	if t == "string" or t == "number" or t == "boolean" then return v end
	if t == "nil" then return nil end
	if t == "Vector3" then return { __t = "Vector3", x = v.X, y = v.Y, z = v.Z } end
	if t == "Vector2" then return { __t = "Vector2", x = v.X, y = v.Y } end
	if t == "Color3" then return { __t = "Color3", r = v.R, g = v.G, b = v.B } end
	if t == "BrickColor" then return { __t = "BrickColor", name = v.Name } end
	if t == "UDim" then return { __t = "UDim", scale = v.Scale, offset = v.Offset } end
	if t == "UDim2" then return { __t = "UDim2", sx = v.X.Scale, ox = v.X.Offset, sy = v.Y.Scale, oy = v.Y.Offset } end
	if t == "CFrame" then return { __t = "CFrame", components = { v:GetComponents() } } end
	if t == "EnumItem" then return { __t = "EnumItem", enum = tostring(v.EnumType), name = v.Name } end
	if t == "NumberSequence" then
		local keys = {}
		for _, k in v.Keypoints do
			table.insert(keys, { time = k.Time, value = k.Value, envelope = k.Envelope })
		end
		return { __t = "NumberSequence", keypoints = keys }
	end
	if t == "ColorSequence" then
		local keys = {}
		for _, k in v.Keypoints do
			table.insert(keys, { time = k.Time, r = k.Value.R, g = k.Value.G, b = k.Value.B })
		end
		return { __t = "ColorSequence", keypoints = keys }
	end
	if t == "Rect" then
		return { __t = "Rect", minX = v.Min.X, minY = v.Min.Y, maxX = v.Max.X, maxY = v.Max.Y }
	end
	if t == "Instance" then
		-- Cross-references are not preserved across revert; record a path
		-- hint so the agent can see what was pointed at.
		return { __t = "InstanceRef", path = getInstancePath(v) }
	end
	-- Fallback: tostring. Strings still round-trip into String-typed props.
	return tostring(v)
end

local function snapshotInstance(obj: Instance): { [string]: any }
	local node: { [string]: any } = {
		className = obj.ClassName,
		name = obj.Name,
		properties = {},
		attributes = {},
		tags = {},
		children = {},
	}
	for _, p in SNAPSHOT_PROPS do
		local ok, v = pcall(function() return (obj :: any)[p] end)
		if ok and v ~= nil then
			local serialized = serializePropValue(v)
			if serialized ~= nil then
				node.properties[p] = serialized
			end
		end
	end
	-- Source for scripts so we can faithfully restore code state.
	if obj:IsA("LuaSourceContainer") then
		local srcOk, src = pcall(function() return ScriptEditorService:GetEditorSource(obj) end)
		if srcOk then node.properties["Source"] = src end
	end
	for k, v in obj:GetAttributes() do
		node.attributes[k] = serializePropValue(v)
	end
	for _, tag in CollectionService:GetTags(obj) do
		table.insert(node.tags, tag)
	end
	for _, child in obj:GetChildren() do
		table.insert(node.children, snapshotInstance(child))
	end
	return node
end

handlers["snapshot_subtree"] = function(params)
	if not params or not params.scope or type(params.scope) ~= "table" then
		return { success = false, error = "Missing required parameter: scope (array of instance paths)" }
	end
	local roots: { { path: string, snapshot: any } } = {}
	local missing = {}
	for _, path in params.scope do
		local inst = resolveInstance(path)
		if not inst then
			table.insert(missing, path)
		else
			table.insert(roots, { path = path, parentPath = getInstancePath(inst.Parent or game), snapshot = snapshotInstance(inst) })
		end
	end
	if #missing > 0 then
		return { success = false, error = "Scope paths not found: " .. table.concat(missing, ", ") }
	end
	return { success = true, data = { roots = roots, capturedAt = os.time() } }
end

-- Inverse of serializePropValue. Restores a JSON-encoded property back to
-- its native Roblox type. Returns nil for InstanceRef (we can't recreate
-- arbitrary cross-references) and unknown tagged shapes.
local function deserializePropValue(val: any): any
	if type(val) ~= "table" then return val end
	if val.__t == nil then return val end
	local kind = val.__t
	if kind == "Vector3" then return Vector3.new(val.x, val.y, val.z) end
	if kind == "Vector2" then return Vector2.new(val.x, val.y) end
	if kind == "Color3" then return Color3.new(val.r, val.g, val.b) end
	if kind == "BrickColor" then
		local ok, bc = pcall(function() return BrickColor.new(val.name) end)
		if ok then return bc end
		return nil
	end
	if kind == "UDim" then return UDim.new(val.scale, val.offset) end
	if kind == "UDim2" then return UDim2.new(val.sx, val.ox, val.sy, val.oy) end
	if kind == "CFrame" then
		local c = val.components
		if type(c) == "table" and #c >= 12 then
			return CFrame.new(c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10], c[11], c[12])
		end
		return nil
	end
	if kind == "EnumItem" then
		-- val.enum is like "Enum.Material"; resolve via the global Enum table.
		local enumName = string.match(val.enum, "Enum%.(.+)$") or val.enum
		local ok, enumObj = pcall(function() return (Enum :: any)[enumName] end)
		if ok and enumObj then
			local itemOk, item = pcall(function() return enumObj[val.name] end)
			if itemOk then return item end
		end
		return nil
	end
	if kind == "NumberSequence" then
		local keys = {}
		for _, k in val.keypoints do
			table.insert(keys, NumberSequenceKeypoint.new(k.time, k.value, k.envelope or 0))
		end
		return NumberSequence.new(keys)
	end
	if kind == "ColorSequence" then
		local keys = {}
		for _, k in val.keypoints do
			table.insert(keys, ColorSequenceKeypoint.new(k.time, Color3.new(k.r, k.g, k.b)))
		end
		return ColorSequence.new(keys)
	end
	if kind == "Rect" then
		return Rect.new(val.minX, val.minY, val.maxX, val.maxY)
	end
	if kind == "InstanceRef" then
		-- Best-effort: try to resolve the path now; nil if it no longer exists.
		return resolveInstance(val.path)
	end
	return nil
end

local function restoreInstance(node: any, parentInst: Instance): Instance?
	local ok, inst = pcall(Instance.new, node.className)
	if not ok or not inst then return nil end
	inst.Name = node.name
	-- Source first so script body restores before any descendants reference it.
	if node.properties.Source and inst:IsA("LuaSourceContainer") then
		pcall(function() ScriptEditorService:UpdateSourceAsync(inst, function() return node.properties.Source end) end)
	end
	for prop, val in node.properties do
		if prop ~= "Source" and prop ~= "Name" then
			local typedVal = deserializePropValue(val)
			if typedVal ~= nil then
				pcall(function() (inst :: any)[prop] = typedVal end)
			end
		end
	end
	for attrKey, attrVal in node.attributes or {} do
		local typedVal = deserializePropValue(attrVal)
		if typedVal ~= nil then
			pcall(function() inst:SetAttribute(attrKey, typedVal) end)
		end
	end
	for _, tag in node.tags or {} do
		pcall(function() CollectionService:AddTag(inst, tag) end)
	end
	inst.Parent = parentInst
	for _, childNode in node.children or {} do
		restoreInstance(childNode, inst)
	end
	return inst
end

handlers["revert_subtree"] = function(params)
	if not params or not params.scope or not params.snapshot then
		return { success = false, error = "Missing required parameters: scope, snapshot" }
	end
	local roots = params.snapshot.roots
	if type(roots) ~= "table" then
		return { success = false, error = "Snapshot has no roots[] — bad payload" }
	end
	ChangeHistoryService:SetWaypoint("LS:revert checkpoint")
	local restored = 0
	local scripts = 0
	for _, entry in roots do
		local parentInst = resolveInstance(entry.parentPath)
		if parentInst then
			-- Delete the existing instance at entry.path if it still exists; then
			-- rebuild from snapshot. This is the simplest semantic match for
			-- "restore the subtree to exactly the captured state."
			local existing = resolveInstance(entry.path)
			if existing then existing:Destroy() end
			local function countScripts(node: any): number
				local n = if node.className and string.find(node.className, "Script") then 1 else 0
				for _, child in node.children or {} do n += countScripts(child) end
				return n
			end
			local function countAll(node: any): number
				local n = 1
				for _, child in node.children or {} do n += countAll(child) end
				return n
			end
			restoreInstance(entry.snapshot, parentInst)
			restored += countAll(entry.snapshot)
			scripts += countScripts(entry.snapshot)
		end
	end
	ChangeHistoryService:SetWaypoint("LS:reverted checkpoint")
	return { success = true, data = { restoredInstances = restored, restoredScripts = scripts } }
end

-- Count registered handlers for status display
local HANDLER_COUNT = 0
for _ in handlers do HANDLER_COUNT += 1 end
toolsRow.Text = "Tools: " .. HANDLER_COUNT .. " registered"

-- Copy LS Handle toolbar button — pulls or creates a stable id for each
-- selected instance and writes a `ls://<uuid>` list to the clipboard.
copyHandleButton.Click:Connect(function()
	if INSPECTOR_ONLY then
		showToast("Inspector build: cannot mint new handles. Use the standard plugin.", "error")
		return
	end
	local selection = Selection:Get()
	if #selection == 0 then
		showToast("Select one or more instances first", "error")
		return
	end
	local handles = {}
	for _, inst in selection do
		local existing = inst:GetAttribute("LSStableId")
		local id: string
		if type(existing) == "string" and existing ~= "" then
			id = existing
		else
			id = HttpService:GenerateGUID(false)
			ChangeHistoryService:SetWaypoint("LS:tag stable id")
			inst:SetAttribute("LSStableId", id)
			ChangeHistoryService:SetWaypoint("LS:tagged stable id")
		end
		stableIdIndex[id] = inst
		table.insert(handles, "ls://" .. id)
	end
	local payload = table.concat(handles, "\n")
	local ok, errMsg = pcall(function() plugin:SetClipboard(payload) end)
	if ok then
		showToast(string.format("Copied %d handle(s)", #handles), "success")
	else
		showToast("Clipboard error: " .. tostring(errMsg), "error")
	end
end)

-- ============================================================================
-- Main Communication Loop
-- ============================================================================

local function heartbeat()
	local t0 = os.clock()
	local ok, result = httpPost("/heartbeat", {
		instanceId = instanceId, pluginVersion = PLUGIN_VERSION, studioVersion = "N/A",
		placeName = game.Name ~= "" and game.Name or "Unnamed", placeId = game.PlaceId,
		mode = currentMode, state = pluginState,
	})
	lastLatencyMs = math.floor((os.clock() - t0) * 1000)
	if ok and result then
		lastHeartbeatData = result
		if not connected then
			connected = true
			updateStatus("idle", "Connected — idle")
			showToast("Connected to server", "success")
		end
		if result.mode then currentMode = result.mode end
		return true
	else
		if connected then
			connected = false
			updateStatus("disconnected", "Connection lost")
			showToast("Connection lost", "error")
		end
		return false
	end
end

local function pollForWork()
	local ok, request = httpGet("/poll/" .. instanceId)
	if ok and request and request.id then
		updateStatus("active", "Running: " .. (request.action or "unknown"))
		addFeedEntry(request.action or "unknown", "pending")

		local startTime = os.clock()
		local handler = handlers[request.action]
		local response
		if INSPECTOR_ONLY and not READ_ONLY_TOOLS[request.action] then
			response = { success = false, error = "Inspector build: write tools are disabled. Install the standard Linkedsword plugin to use '" .. tostring(request.action) .. "'." }
		elseif handler then
			local handlerOk, handlerResult = pcall(handler, request.params or {})
			response = handlerOk and handlerResult or { success = false, error = "Handler error: " .. tostring(handlerResult) }
		else
			response = { success = false, error = "Unknown tool: " .. (request.action or "nil") }
		end
		local duration = (os.clock() - startTime) * 1000

		httpPost("/response", { id = request.id, success = response.success, data = response.data, error = response.error })

		-- Determine scriptPath for clickable feed entries
		local scriptPath = nil
		if SCRIPT_TOOLS[request.action] and request.params then
			scriptPath = request.params.path or request.params.scriptPath
		end
		addFeedEntry(request.action or "unknown", response.success and "success" or "error", duration, scriptPath)

		-- Keep cat active for at least ACTIVE_MIN_DURATION seconds
		activeUntil = os.clock() + ACTIVE_MIN_DURATION
		task.delay(ACTIVE_MIN_DURATION, function()
			if os.clock() >= activeUntil and pluginState == "active" then
				updateStatus("idle", "Connected — idle")
			end
		end)
	end
end

local function mainLoop()
	updateStatus("disconnected", "Connecting...")
	while running do
		local heartbeatOk = heartbeat()
		if not heartbeatOk and not connected then
			updateStatus("error", "Connection failed — check server")
			for _ = 1, 50 do if not running then break end; task.wait(0.1) end
			if not running then break end
			updateStatus("disconnected", "Connecting...")
			continue
		end
		if connected then
			local ok, err = pcall(pollForWork)
			if not ok then warn("[LS] Poll error:", err); updateStatus("error", "Poll error"); task.wait(2) end
		else
			task.wait(HEARTBEAT_INTERVAL)
		end
		task.wait(0.1)
	end
end

-- ============================================================================
-- Mascot Animations (started via registry system)
-- ============================================================================

startMascotAnimations()

-- ============================================================================
-- Toggle Button
-- ============================================================================

local function startConnection()
	if running then return end
	running = true
	widget.Enabled = true
	updateConnectButton()
	task.spawn(mainLoop)
end

local function stopConnection()
	if not running then return end
	running = false
	connected = false
	updateStatus("disconnected", "Disconnected")
	updateConnectButton()
end

toggleButton.Click:Connect(function()
	if running then stopConnection(); widget.Enabled = false
	else startConnection() end
end)

connectButton.Activated:Connect(function()
	if running then stopConnection() else startConnection() end
end)

-- ============================================================================
-- Plugin Cleanup
-- ============================================================================

plugin.Unloading:Connect(function()
	running = false
	connected = false
	pluginState = ""
	if currentMascotStop then currentMascotStop() end
end)

-- Initial state
updateStatus("disconnected", "Click toolbar button to connect")
]]></ProtectedString>
			<bool name="Disabled">false</bool>
			<Content name="LinkedSource"><null></null></Content>
			<token name="RunContext">0</token>
		</Properties>
	</Item>
</roblox>
