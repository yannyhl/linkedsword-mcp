-- ============================================================================
-- UI Helper Functions
-- ============================================================================

local toastOrder = 0
showToast = function(message: string, toastType: string?)
	toastType = toastType or "info"
	toastOrder += 1

	local colorMap = {
		success = theme.success,
		error = theme.error,
		info = theme.accent,
	}
	local accentColor = rgbFromTable(colorMap[toastType] or theme.accent)

	local toast = Instance.new("Frame")
	toast.Name = "Toast_" .. toastOrder
	toast.Size = UDim2.new(1, 0, 0, 28)
	toast.BackgroundColor3 = rgbFromTable(theme.cardBg)
	toast.LayoutOrder = toastOrder
	toast.ZIndex = 10
	toast.Parent = toastContainer
	Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 6)

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1
	stroke.Color = accentColor
	stroke.Parent = toast

	local accentBar = Instance.new("Frame")
	accentBar.Size = UDim2.new(0, 3, 1, -4)
	accentBar.Position = UDim2.new(0, 2, 0, 2)
	accentBar.BackgroundColor3 = accentColor
	accentBar.BorderSizePixel = 0
	accentBar.ZIndex = 11
	accentBar.Parent = toast
	Instance.new("UICorner", accentBar).CornerRadius = UDim.new(0, 2)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -16, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = message
	label.TextColor3 = rgbFromTable(theme.textPrimary)
	label.TextSize = 10
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 11
	label.Parent = toast

	table.insert(activeToasts, toast)
	while #activeToasts > MAX_VISIBLE_TOASTS do
		local oldest = table.remove(activeToasts, 1)
		if oldest and oldest.Parent then oldest:Destroy() end
	end

	task.delay(3, function()
		local fadeTween = TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 })
		local labelFade = TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 })
		local strokeFade = TweenService:Create(stroke, TweenInfo.new(0.3), { Transparency = 1 })
		local barFade = TweenService:Create(accentBar, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
		fadeTween:Play(); labelFade:Play(); strokeFade:Play(); barFade:Play()
		fadeTween.Completed:Connect(function()
			toast:Destroy()
			for i, t in activeToasts do
				if t == toast then table.remove(activeToasts, i); break end
			end
		end)
	end)
end

updateStatus = function(state: string, message: string)
	pluginState = state
	statusText.Text = message

	local colors = {
		disconnected = rgbFromTable(theme.textSecondary),
		idle = Color3.fromRGB(59, 130, 246),
		active = rgbFromTable(theme.accent),
		error = rgbFromTable(theme.error),
		playtesting = rgbFromTable(theme.success),
	}
	statusDot.BackgroundColor3 = colors[state] or colors.disconnected
	updateStatusDetails()

	-- Delegate mascot visuals to the current skin
	if currentMascotParts and currentMascotSkin then
		local skin = MascotRegistry[currentMascotSkin]
		if skin then skin.updateState(currentMascotParts, state, theme) end
	end
end

local feedOrder = 0
local function addFeedEntry(toolName: string, status: string, duration: number?, scriptPath: string?)
	feedOrder += 1
	local isScriptTool = scriptPath ~= nil

	local color = status == "success" and rgbFromTable(theme.addLine)
		or status == "error" and rgbFromTable(theme.delLine)
		or rgbFromTable(theme.textSecondary)

	-- Outer container: Frame for regular entries, TextButton for script tool entries
	local entryFrame
	if isScriptTool then
		entryFrame = Instance.new("TextButton")
		entryFrame.Text = ""
		entryFrame.BorderSizePixel = 0
		entryFrame.BackgroundColor3 = rgbFromTable(theme.cardBg)
		entryFrame.BackgroundTransparency = 0.5
		Instance.new("UICorner", entryFrame).CornerRadius = UDim.new(0, 3)
		entryFrame.Activated:Connect(function()
			diffWidget.Enabled = true
		end)
	else
		entryFrame = Instance.new("Frame")
		entryFrame.BackgroundColor3 = rgbFromTable(theme.cardBg)
		entryFrame.BackgroundTransparency = if feedOrder % 2 == 0 then 1 else 0.92
	end

	entryFrame.Name = "Entry_" .. feedOrder
	entryFrame.Size = UDim2.new(1, 0, 0, 22)
	entryFrame.LayoutOrder = -feedOrder
	entryFrame.Parent = feedScroll

	-- Status dot (4px colored circle)
	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.Size = UDim2.new(0, 4, 0, 4)
	dot.Position = UDim2.new(0, 2, 0.5, -2)
	dot.BackgroundColor3 = color
	dot.BorderSizePixel = 0
	dot.Parent = entryFrame
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

	-- Tool name (left-aligned)
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Name"
	nameLabel.Size = UDim2.new(1, -95, 1, 0)
	nameLabel.Position = UDim2.new(0, 10, 0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = toolName .. (isScriptTool and " ↗" or "")
	nameLabel.TextColor3 = rgbFromTable(theme.textPrimary)
	nameLabel.TextSize = 10
	nameLabel.Font = Enum.Font.Code
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Parent = entryFrame

	-- Timestamp (right side, dim)
	local timeLabel = Instance.new("TextLabel")
	timeLabel.Name = "Time"
	timeLabel.Size = UDim2.new(0, 30, 1, 0)
	timeLabel.Position = UDim2.new(1, if duration then -85 else -32, 0, 0)
	timeLabel.BackgroundTransparency = 1
	timeLabel.Text = os.date("%H:%M")
	timeLabel.TextColor3 = rgbFromTable(theme.muted)
	timeLabel.TextSize = 8
	timeLabel.Font = Enum.Font.Code
	timeLabel.TextXAlignment = Enum.TextXAlignment.Right
	timeLabel.Parent = entryFrame

	-- Duration (right-aligned, muted)
	if duration then
		local durLabel = Instance.new("TextLabel")
		durLabel.Name = "Duration"
		durLabel.Size = UDim2.new(0, 50, 1, 0)
		durLabel.Position = UDim2.new(1, -50, 0, 0)
		durLabel.BackgroundTransparency = 1
		durLabel.Text = string.format("%.0fms", duration)
		durLabel.TextColor3 = rgbFromTable(theme.textSecondary)
		durLabel.TextSize = 9
		durLabel.Font = Enum.Font.Code
		durLabel.TextXAlignment = Enum.TextXAlignment.Right
		durLabel.Parent = entryFrame
	end

	-- Keep feed bounded
	local children = feedScroll:GetChildren()
	local entries = {}
	for _, child in children do
		if string.sub(child.Name, 1, 6) == "Entry_" then
			table.insert(entries, child)
		end
	end
	if #entries > (settings.maxFeedEntries or 100) then
		table.sort(entries, function(a, b) return a.LayoutOrder > b.LayoutOrder end)
		for i = (settings.maxFeedEntries or 100) + 1, #entries do
			entries[i]:Destroy()
		end
	end
end

-- ============================================================================
-- Diff Review UI Functions (renders into the pop-out diffWidget)
-- ============================================================================

local function updateDiffBadge()
	local count = 0
	for _ in diffQueue do count += 1 end
	diffOpenBtn.Text = "View Diffs (" .. count .. ")"
	diffBtnFrame.Visible = true
	diffEmptyLabel.Visible = (count == 0 and diffViewMode == "pending")
	historyTab.Text = "History (" .. #diffHistory .. ")"
end

-- Creates a single diff line row (line number gutters + code content)
local function createDiffLineRow(lineData, layoutOrder, inHunk)
	local row = Instance.new("Frame")
	row.Name = "Line_" .. layoutOrder
	row.Size = UDim2.new(1, 0, 0, LINE_HEIGHT)
	row.BorderSizePixel = 0
	row.LayoutOrder = layoutOrder

	local isAdd = lineData.type == "add"
	local isDel = lineData.type == "del"
	local isPlain = lineData.type == "plain"

	-- Full row background
	if isAdd then
		row.BackgroundColor3 = ADD_BG
	elseif isDel then
		row.BackgroundColor3 = DEL_BG
	elseif inHunk then
		row.BackgroundColor3 = Color3.fromRGB(17, 21, 28)
	else
		row.BackgroundColor3 = DIFF_BG
	end

	-- Blue accent bar for hunk lines
	if inHunk then
		local accent = Instance.new("Frame")
		accent.Size = UDim2.new(0, 3, 1, 0)
		accent.Position = UDim2.new(0, 0, 0, 0)
		accent.BackgroundColor3 = Color3.fromRGB(59, 130, 246)
		accent.BorderSizePixel = 0
		accent.ZIndex = 2
		accent.Parent = row
	end

	-- Old line number gutter
	local oldGutter = Instance.new("TextLabel")
	oldGutter.Size = UDim2.new(0, GUTTER_WIDTH, 1, 0)
	oldGutter.Position = UDim2.new(0, 0, 0, 0)
	oldGutter.BackgroundColor3 = isAdd and ADD_BG_STRONG or isDel and DEL_BG_STRONG or DIFF_HEADER_BG
	oldGutter.BackgroundTransparency = 0.5
	oldGutter.BorderSizePixel = 0
	oldGutter.Text = if isDel or isPlain or (not isAdd and lineData.lineOld) then tostring(lineData.lineOld or "") else ""
	oldGutter.TextColor3 = GUTTER_TEXT
	oldGutter.TextSize = 12
	oldGutter.Font = Enum.Font.Code
	oldGutter.Parent = row

	-- New line number gutter
	local newGutter = Instance.new("TextLabel")
	newGutter.Size = UDim2.new(0, GUTTER_WIDTH, 1, 0)
	newGutter.Position = UDim2.new(0, GUTTER_WIDTH, 0, 0)
	newGutter.BackgroundColor3 = isAdd and ADD_BG_STRONG or isDel and DEL_BG_STRONG or DIFF_HEADER_BG
	newGutter.BackgroundTransparency = 0.5
	newGutter.BorderSizePixel = 0
	newGutter.Text = if isAdd or isPlain or (not isDel and lineData.lineNew) then tostring(lineData.lineNew or "") else ""
	newGutter.TextColor3 = GUTTER_TEXT
	newGutter.TextSize = 12
	newGutter.Font = Enum.Font.Code
	newGutter.Parent = row

	-- +/- prefix
	local prefix = isAdd and "+" or isDel and "-" or " "

	-- Code content
	local codeLabel = Instance.new("TextLabel")
	codeLabel.Size = UDim2.new(1, -(GUTTER_WIDTH * 2 + 8), 1, 0)
	codeLabel.Position = UDim2.new(0, GUTTER_WIDTH * 2 + 8, 0, 0)
	codeLabel.BackgroundTransparency = 1
	codeLabel.Text = prefix .. " " .. (lineData.content or "")
	codeLabel.TextColor3 = isAdd and ADD_TEXT or isDel and DEL_TEXT or CTX_TEXT
	codeLabel.TextSize = 13
	codeLabel.Font = Enum.Font.Code
	codeLabel.TextXAlignment = Enum.TextXAlignment.Left
	codeLabel.TextTruncate = Enum.TextTruncate.AtEnd
	codeLabel.Parent = row

	return row
end

-- ============================================================================
-- Diff History UI (renders into diffScroll when History tab is active)
-- ============================================================================

local function clearDiffScroll()
	for _, child in diffScroll:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel") then
			if child.Name ~= "EmptyState" then child:Destroy() end
		end
	end
end

local renderHistoryUI -- forward declaration

local function renderHistoryDetail(entry)
	clearDiffScroll()
	diffEmptyLabel.Visible = false

	local lineOrder = 0

	-- Back button bar
	lineOrder += 1
	local backBar = Instance.new("Frame")
	backBar.Name = "BackBar"
	backBar.Size = UDim2.new(1, 0, 0, 32)
	backBar.BackgroundColor3 = DIFF_HEADER_BG
	backBar.BorderSizePixel = 0
	backBar.LayoutOrder = lineOrder
	backBar.Parent = diffScroll

	local backBtn = Instance.new("TextButton")
	backBtn.Size = UDim2.new(0, 60, 0, 24)
	backBtn.Position = UDim2.new(0, 8, 0.5, -12)
	backBtn.BackgroundColor3 = Color3.fromRGB(63, 63, 70)
	backBtn.TextColor3 = Color3.fromRGB(201, 209, 217)
	backBtn.Text = "← Back"
	backBtn.TextSize = 11
	backBtn.Font = Enum.Font.GothamBold
	backBtn.BorderSizePixel = 0
	backBtn.Parent = backBar
	Instance.new("UICorner", backBtn).CornerRadius = UDim.new(0, 4)

	backBtn.Activated:Connect(function()
		selectedHistoryIdx = nil
		renderHistoryUI()
	end)

	-- File header
	lineOrder += 1
	local fileHeader = Instance.new("Frame")
	fileHeader.Name = "HistoryFileHeader"
	fileHeader.Size = UDim2.new(1, 0, 0, 36)
	fileHeader.BackgroundColor3 = DIFF_HEADER_BG
	fileHeader.BorderSizePixel = 0
	fileHeader.LayoutOrder = lineOrder
	fileHeader.Parent = diffScroll

	local fileName = Instance.new("TextLabel")
	fileName.Size = UDim2.new(1, -160, 1, 0)
	fileName.Position = UDim2.new(0, 12, 0, 0)
	fileName.BackgroundTransparency = 1
	fileName.Text = entry.scriptPath or entry.scriptName or "Script"
	fileName.TextColor3 = Color3.fromRGB(201, 209, 217)
	fileName.TextSize = 13
	fileName.Font = Enum.Font.Code
	fileName.TextXAlignment = Enum.TextXAlignment.Left
	fileName.TextTruncate = Enum.TextTruncate.AtEnd
	fileName.Parent = fileHeader

	local statsLabel = Instance.new("TextLabel")
	statsLabel.Size = UDim2.new(0, 70, 0, 22)
	statsLabel.Position = UDim2.new(1, -150, 0.5, -11)
	statsLabel.BackgroundTransparency = 1
	statsLabel.RichText = true
	statsLabel.Text = '<font color="#3fb950">+' .. (entry.addCount or 0) .. '</font>  <font color="#f85149">-' .. (entry.delCount or 0) .. '</font>'
	statsLabel.TextSize = 12
	statsLabel.Font = Enum.Font.Code
	statsLabel.Parent = fileHeader

	local outcomeBadge = Instance.new("TextLabel")
	outcomeBadge.Size = UDim2.new(0, 56, 0, 22)
	outcomeBadge.Position = UDim2.new(1, -68, 0.5, -11)
	outcomeBadge.BackgroundColor3 = if entry.outcome == "accepted" then Color3.fromRGB(35, 134, 54)
		elseif entry.outcome == "rejected" then Color3.fromRGB(140, 25, 30)
		else Color3.fromRGB(130, 100, 20)
	outcomeBadge.TextColor3 = Color3.fromRGB(255, 255, 255)
	outcomeBadge.Text = if entry.outcome == "accepted" then "Accepted"
		elseif entry.outcome == "rejected" then "Rejected"
		else "Partial"
	outcomeBadge.TextSize = 9
	outcomeBadge.Font = Enum.Font.GothamBold
	outcomeBadge.Parent = fileHeader
	Instance.new("UICorner", outcomeBadge).CornerRadius = UDim.new(0, 4)

	-- Build display lines: full script if oldSource available, else hunks only
	local firstChangePixelOffset = nil
	local pixelOffset = 32 + 36 -- back bar + file header

	if entry.hunks then
		local displayLines
		if entry.oldSource then
			local fullLines = buildFullScriptLines(entry.oldSource, entry.hunks)
			displayLines = collapseFullScriptLines(fullLines, expandedRegions)
		else
			displayLines = {}
			for hunkIdx, hunk in entry.hunks do
				table.insert(displayLines, { isHunkBoundary = true, hunkIdx = hunkIdx })
				for _, line in hunk.lines do
					table.insert(displayLines, {
						type = line.type,
						lineOld = line.lineOld,
						lineNew = line.lineNew,
						content = line.content,
						hunkIdx = hunkIdx,
					})
				end
			end
		end

		for _, displayEntry in displayLines do
			if displayEntry.isHunkBoundary then
				local hunkIdx = displayEntry.hunkIdx
				local hunk = entry.hunks[hunkIdx]
				lineOrder += 1

				-- Hunk separator
				local hunkSep = Instance.new("Frame")
				hunkSep.Name = "HistHunkSep_" .. hunkIdx
				hunkSep.Size = UDim2.new(1, 0, 0, LINE_HEIGHT)
				hunkSep.BackgroundColor3 = HUNK_SEPARATOR_BG
				hunkSep.BorderSizePixel = 0
				hunkSep.LayoutOrder = lineOrder
				hunkSep.Parent = diffScroll

				local hunkLabel = Instance.new("TextLabel")
				hunkLabel.Size = UDim2.new(1, -80, 1, 0)
				hunkLabel.Position = UDim2.new(0, GUTTER_WIDTH * 2 + 8, 0, 0)
				hunkLabel.BackgroundTransparency = 1
				hunkLabel.Text = string.format("@@ Hunk %d — lines %d-%d @@", hunkIdx, hunk.startOld or 0, (hunk.startOld or 0) + #hunk.lines)
				hunkLabel.TextColor3 = HUNK_SEPARATOR_TEXT
				hunkLabel.TextSize = 12
				hunkLabel.Font = Enum.Font.Code
				hunkLabel.TextXAlignment = Enum.TextXAlignment.Left
				hunkLabel.Parent = hunkSep

				-- Read-only status badge
				local badge = Instance.new("TextLabel")
				badge.Size = UDim2.new(0, 60, 0, 18)
				badge.Position = UDim2.new(1, -66, 0.5, -9)
				badge.BackgroundTransparency = 1
				badge.Text = if hunk.status == "accepted" then "✓ Accepted" else "✗ Rejected"
				badge.TextColor3 = if hunk.status == "accepted" then ADD_TEXT else DEL_TEXT
				badge.TextSize = 10
				badge.Font = Enum.Font.GothamBold
				badge.Parent = hunkSep

				pixelOffset += LINE_HEIGHT

			elseif displayEntry.isCollapsed then
				lineOrder += 1
				local collapseBar = Instance.new("TextButton")
				collapseBar.Name = "HistCollapse_" .. lineOrder
				collapseBar.Size = UDim2.new(1, 0, 0, LINE_HEIGHT)
				collapseBar.BackgroundColor3 = DIFF_HEADER_BG
				collapseBar.BorderSizePixel = 0
				collapseBar.LayoutOrder = lineOrder
				collapseBar.Text = string.format("  ⋯ %d lines hidden ⋯", displayEntry.hiddenCount)
				collapseBar.TextColor3 = GUTTER_TEXT
				collapseBar.TextSize = 11
				collapseBar.Font = Enum.Font.Code
				collapseBar.TextXAlignment = Enum.TextXAlignment.Center
				collapseBar.Parent = diffScroll

				local capturedKey = displayEntry.regionKey
				collapseBar.Activated:Connect(function()
					expandedRegions[capturedKey] = true
					renderHistoryDetail(entry)
				end)

				pixelOffset += LINE_HEIGHT

			else
				lineOrder += 1
				if not firstChangePixelOffset and (displayEntry.type == "add" or displayEntry.type == "del") then
					firstChangePixelOffset = pixelOffset
				end
				local lineRow = createDiffLineRow(displayEntry, lineOrder, displayEntry.hunkIdx ~= nil)
				lineRow.Parent = diffScroll
				pixelOffset += LINE_HEIGHT
			end
		end
	end

	-- Auto-scroll to first change in history detail
	if firstChangePixelOffset then
		task.defer(function()
			local scrollY = math.max(0, firstChangePixelOffset - diffScroll.AbsoluteSize.Y / 3)
			diffScroll.CanvasPosition = Vector2.new(0, scrollY)
		end)
	end

	-- Bottom border
	lineOrder += 1
	local bottomBorder = Instance.new("Frame")
	bottomBorder.Size = UDim2.new(1, 0, 0, 1)
	bottomBorder.BackgroundColor3 = DIFF_BORDER
	bottomBorder.BorderSizePixel = 0
	bottomBorder.LayoutOrder = lineOrder
	bottomBorder.Parent = diffScroll
end

renderHistoryUI = function()
	clearDiffScroll()
	diffEmptyLabel.Text = if #diffHistory == 0 then "No diff history" else ""
	diffEmptyLabel.Visible = #diffHistory == 0

	historyTab.Text = "History (" .. #diffHistory .. ")"

	if selectedHistoryIdx then
		local entry = diffHistory[selectedHistoryIdx]
		if entry then
			renderHistoryDetail(entry)
		else
			selectedHistoryIdx = nil
		end
		return
	end

	-- Render history list (most recent first)
	for i = #diffHistory, 1, -1 do
		local entry = diffHistory[i]
		local layoutOrder = #diffHistory - i

		local row = Instance.new("TextButton")
		row.Name = "History_" .. i
		row.Size = UDim2.new(1, -8, 0, 52)
		row.Position = UDim2.new(0, 4, 0, 0)
		row.BackgroundColor3 = DIFF_HEADER_BG
		row.BorderSizePixel = 0
		row.LayoutOrder = layoutOrder
		row.Text = ""
		row.AutoButtonColor = false
		row.Parent = diffScroll
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

		-- Outcome icon
		local outcomeIcon = Instance.new("TextLabel")
		outcomeIcon.Size = UDim2.new(0, 20, 0, 20)
		outcomeIcon.Position = UDim2.new(0, 8, 0, 8)
		outcomeIcon.BackgroundTransparency = 1
		outcomeIcon.Text = if entry.outcome == "accepted" then "✓"
			elseif entry.outcome == "rejected" then "✗"
			else "◐"
		outcomeIcon.TextColor3 = if entry.outcome == "accepted" then ADD_TEXT
			elseif entry.outcome == "rejected" then DEL_TEXT
			else Color3.fromRGB(255, 193, 7)
		outcomeIcon.TextSize = 14
		outcomeIcon.Font = Enum.Font.GothamBold
		outcomeIcon.Parent = row

		-- Script path
		local pathLabel = Instance.new("TextLabel")
		pathLabel.Size = UDim2.new(1, -100, 0, 18)
		pathLabel.Position = UDim2.new(0, 32, 0, 4)
		pathLabel.BackgroundTransparency = 1
		pathLabel.Text = entry.scriptPath or entry.scriptName or "Script"
		pathLabel.TextColor3 = Color3.fromRGB(201, 209, 217)
		pathLabel.TextSize = 12
		pathLabel.Font = Enum.Font.Code
		pathLabel.TextXAlignment = Enum.TextXAlignment.Left
		pathLabel.TextTruncate = Enum.TextTruncate.AtEnd
		pathLabel.Parent = row

		-- Stats + timestamp line
		local statsLine = Instance.new("TextLabel")
		statsLine.Size = UDim2.new(1, -40, 0, 14)
		statsLine.Position = UDim2.new(0, 32, 0, 24)
		statsLine.BackgroundTransparency = 1
		statsLine.RichText = true
		local timeStr = os.date("%H:%M", entry.resolvedAt or entry.timestamp)
		statsLine.Text = '<font color="#3fb950">+' .. (entry.addCount or 0) .. '</font>  <font color="#f85149">-' .. (entry.delCount or 0) .. '</font>  <font color="#484F58">' .. timeStr .. '</font>'
		statsLine.TextSize = 10
		statsLine.Font = Enum.Font.Code
		statsLine.TextXAlignment = Enum.TextXAlignment.Left
		statsLine.Parent = row

		-- Hunk count badge
		local hunkCount = if entry.hunks then #entry.hunks else 0
		local hunkBadge = Instance.new("TextLabel")
		hunkBadge.Size = UDim2.new(0, 50, 0, 18)
		hunkBadge.Position = UDim2.new(1, -58, 0.5, -9)
		hunkBadge.BackgroundTransparency = 1
		hunkBadge.Text = hunkCount .. (if hunkCount ~= 1 then " hunks" else " hunk")
		hunkBadge.TextColor3 = GUTTER_TEXT
		hunkBadge.TextSize = 10
		hunkBadge.Font = Enum.Font.Code
		hunkBadge.Parent = row

		-- Click to view detail
		local capturedIdx = i
		row.Activated:Connect(function()
			selectedHistoryIdx = capturedIdx
			renderHistoryUI()
		end)

		-- Spacer between entries
		local spacer = Instance.new("Frame")
		spacer.Size = UDim2.new(1, 0, 0, 4)
		spacer.BackgroundTransparency = 1
		spacer.LayoutOrder = layoutOrder + 0.5
		spacer.Parent = diffScroll
	end

	-- Clear History button at the bottom
	if #diffHistory > 0 then
		local clearBtn = Instance.new("TextButton")
		clearBtn.Name = "ClearHistory"
		clearBtn.Size = UDim2.new(1, -8, 0, 28)
		clearBtn.Position = UDim2.new(0, 4, 0, 0)
		clearBtn.BackgroundColor3 = Color3.fromRGB(63, 63, 70)
		clearBtn.TextColor3 = GUTTER_TEXT
		clearBtn.Text = "Clear History"
		clearBtn.TextSize = 11
		clearBtn.Font = Enum.Font.GothamMedium
		clearBtn.BorderSizePixel = 0
		clearBtn.LayoutOrder = #diffHistory + 1
		clearBtn.Parent = diffScroll
		Instance.new("UICorner", clearBtn).CornerRadius = UDim.new(0, 6)

		local confirmActive = false
		clearBtn.Activated:Connect(function()
			if confirmActive then return end
			confirmActive = true
			local count = #diffHistory
			clearBtn.Text = "Delete " .. count .. " entries?"
			clearBtn.TextColor3 = rgbFromTable(theme.error)

			local yesBtn = Instance.new("TextButton")
			yesBtn.Size = UDim2.new(0, 32, 0, 20)
			yesBtn.Position = UDim2.new(1, -72, 0.5, -10)
			yesBtn.BackgroundColor3 = rgbFromTable(theme.error)
			yesBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			yesBtn.Text = "Yes"
			yesBtn.TextSize = 10
			yesBtn.Font = Enum.Font.GothamBold
			yesBtn.BorderSizePixel = 0
			yesBtn.ZIndex = 2
			yesBtn.Parent = clearBtn
			Instance.new("UICorner", yesBtn).CornerRadius = UDim.new(0, 4)

			local noBtn = Instance.new("TextButton")
			noBtn.Size = UDim2.new(0, 28, 0, 20)
			noBtn.Position = UDim2.new(1, -36, 0.5, -10)
			noBtn.BackgroundColor3 = rgbFromTable(theme.muted)
			noBtn.TextColor3 = rgbFromTable(theme.textPrimary)
			noBtn.Text = "No"
			noBtn.TextSize = 10
			noBtn.Font = Enum.Font.GothamBold
			noBtn.BorderSizePixel = 0
			noBtn.ZIndex = 2
			noBtn.Parent = clearBtn
			Instance.new("UICorner", noBtn).CornerRadius = UDim.new(0, 4)

			yesBtn.Activated:Connect(function()
				diffHistory = {}
				saveDiffHistory()
				showToast("Diff history cleared", "info")
				renderHistoryUI()
			end)

			noBtn.Activated:Connect(function()
				yesBtn:Destroy()
				noBtn:Destroy()
				clearBtn.Text = "Clear History"
				clearBtn.TextColor3 = GUTTER_TEXT
				confirmActive = false
			end)

			task.delay(3, function()
				if confirmActive and yesBtn.Parent then
					yesBtn:Destroy()
					noBtn:Destroy()
					clearBtn.Text = "Clear History"
					clearBtn.TextColor3 = GUTTER_TEXT
					confirmActive = false
				end
			end)
		end)
	end
end

local renderDiffUI -- forward declaration (used by switchToDiffView below)

local function switchToDiffView(mode)
	diffViewMode = mode
	selectedHistoryIdx = nil
	pendingTab.BackgroundColor3 = if mode == "pending" then DIFF_BG else DIFF_HEADER_BG
	pendingTab.TextColor3 = if mode == "pending" then Color3.fromRGB(201, 209, 217) else GUTTER_TEXT
	historyTab.BackgroundColor3 = if mode == "history" then DIFF_BG else DIFF_HEADER_BG
	historyTab.TextColor3 = if mode == "history" then Color3.fromRGB(201, 209, 217) else GUTTER_TEXT
	tabIndicator.Position = if mode == "pending" then UDim2.new(0, 0, 1, -2) else UDim2.new(0.5, 0, 1, -2)

	if mode == "pending" then
		renderDiffUI()
	else
		renderHistoryUI()
	end
end

pendingTab.Activated:Connect(function() switchToDiffView("pending") end)
historyTab.Activated:Connect(function() switchToDiffView("history") end)

renderDiffUI = function()
	if diffViewMode ~= "pending" then return end

	-- Clear everything except layout and empty label
	clearDiffScroll()

	local globalFirstChangeOffset = nil
	local globalPixelOffset = 0
	local sectionOrder = 0
	for diffId, diffData in diffQueue do
		sectionOrder += 1

		-- Count stats
		local addCount, delCount = 0, 0
		for _, hunk in diffData.hunks do
			for _, line in hunk.lines do
				if line.type == "add" then addCount += 1 end
				if line.type == "del" then delCount += 1 end
			end
		end

		-- ═══ File header bar (like GitHub's file bar) ═══
		local fileHeader = Instance.new("Frame")
		fileHeader.Name = "FileHeader_" .. diffId
		fileHeader.Size = UDim2.new(1, 0, 0, 36)
		fileHeader.BackgroundColor3 = DIFF_HEADER_BG
		fileHeader.BorderSizePixel = 0
		fileHeader.LayoutOrder = sectionOrder * 1000
		fileHeader.Parent = diffScroll

		-- File name
		local fileName = Instance.new("TextLabel")
		fileName.Size = UDim2.new(1, -220, 1, 0)
		fileName.Position = UDim2.new(0, 12, 0, 0)
		fileName.BackgroundTransparency = 1
		fileName.Text = diffData.scriptPath or diffData.scriptName or "Script"
		fileName.TextColor3 = Color3.fromRGB(201, 209, 217)
		fileName.TextSize = 13
		fileName.Font = Enum.Font.Code
		fileName.TextXAlignment = Enum.TextXAlignment.Left
		fileName.TextTruncate = Enum.TextTruncate.AtEnd
		fileName.Parent = fileHeader

		-- Stats badge
		local statsLabel = Instance.new("TextLabel")
		statsLabel.Size = UDim2.new(0, 80, 0, 22)
		statsLabel.Position = UDim2.new(1, -210, 0.5, -11)
		statsLabel.BackgroundTransparency = 1
		statsLabel.RichText = true
		statsLabel.Text = '<font color="#3fb950">+' .. addCount .. '</font>  <font color="#f85149">-' .. delCount .. '</font>'
		statsLabel.TextSize = 12
		statsLabel.Font = Enum.Font.Code
		statsLabel.Parent = fileHeader

		-- Accept All button (compact)
		local acceptBtn = Instance.new("TextButton")
		acceptBtn.Size = UDim2.new(0, 56, 0, 24)
		acceptBtn.Position = UDim2.new(1, -120, 0.5, -12)
		acceptBtn.BackgroundColor3 = Color3.fromRGB(35, 134, 54)
		acceptBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		acceptBtn.Text = "Accept"
		acceptBtn.TextSize = 11
		acceptBtn.Font = Enum.Font.GothamBold
		acceptBtn.BorderSizePixel = 0
		acceptBtn.Parent = fileHeader
		Instance.new("UICorner", acceptBtn).CornerRadius = UDim.new(0, 6)

		-- Reject All button (compact)
		local rejectBtn = Instance.new("TextButton")
		rejectBtn.Size = UDim2.new(0, 52, 0, 24)
		rejectBtn.Position = UDim2.new(1, -58, 0.5, -12)
		rejectBtn.BackgroundColor3 = Color3.fromRGB(140, 25, 30)
		rejectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		rejectBtn.Text = "Reject"
		rejectBtn.TextSize = 11
		rejectBtn.Font = Enum.Font.GothamBold
		rejectBtn.BorderSizePixel = 0
		rejectBtn.Parent = fileHeader
		Instance.new("UICorner", rejectBtn).CornerRadius = UDim.new(0, 6)

		-- ═══ Render full script with hunks ═══
		local lineOrder = sectionOrder * 1000
		local firstChangePixelOffset = nil
		local pixelOffset = 36 -- file header height

		-- Build display lines: full script if oldSource available, else hunks only
		local displayLines
		if diffData.oldSource then
			local fullLines = buildFullScriptLines(diffData.oldSource, diffData.hunks)
			displayLines = collapseFullScriptLines(fullLines, expandedRegions)
		else
			displayLines = {}
			for hunkIdx, hunk in diffData.hunks do
				table.insert(displayLines, { isHunkBoundary = true, hunkIdx = hunkIdx })
				for _, line in hunk.lines do
					table.insert(displayLines, {
						type = line.type,
						lineOld = line.lineOld,
						lineNew = line.lineNew,
						content = line.content,
						hunkIdx = hunkIdx,
					})
				end
			end
		end

		for _, entry in displayLines do
			if entry.isHunkBoundary then
				local hunkIdx = entry.hunkIdx
				local hunk = diffData.hunks[hunkIdx]
				lineOrder += 1

				-- Hunk separator bar (@@-style)
				local hunkSep = Instance.new("Frame")
				hunkSep.Name = "HunkSep_" .. hunkIdx
				hunkSep.Size = UDim2.new(1, 0, 0, LINE_HEIGHT)
				hunkSep.BackgroundColor3 = HUNK_SEPARATOR_BG
				hunkSep.BorderSizePixel = 0
				hunkSep.LayoutOrder = lineOrder
				hunkSep.Parent = diffScroll

				local hunkLabel = Instance.new("TextLabel")
				hunkLabel.Size = UDim2.new(1, -12, 1, 0)
				hunkLabel.Position = UDim2.new(0, GUTTER_WIDTH * 2 + 8, 0, 0)
				hunkLabel.BackgroundTransparency = 1
				hunkLabel.Text = string.format("@@ Hunk %d — lines %d-%d @@", hunkIdx, hunk.startOld, hunk.startOld + #hunk.lines)
				hunkLabel.TextColor3 = HUNK_SEPARATOR_TEXT
				hunkLabel.TextSize = 12
				hunkLabel.Font = Enum.Font.Code
				hunkLabel.TextXAlignment = Enum.TextXAlignment.Left
				hunkLabel.Parent = hunkSep

				-- Per-hunk accept/reject (small, right-aligned in separator)
				if hunk.status == "pending" then
					local hAccBtn = Instance.new("TextButton")
					hAccBtn.Size = UDim2.new(0, 20, 0, 18)
					hAccBtn.Position = UDim2.new(1, -48, 0.5, -9)
					hAccBtn.BackgroundColor3 = Color3.fromRGB(35, 134, 54)
					hAccBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					hAccBtn.Text = "✓"
					hAccBtn.TextSize = 11
					hAccBtn.Font = Enum.Font.GothamBold
					hAccBtn.BorderSizePixel = 0
					hAccBtn.Parent = hunkSep
					Instance.new("UICorner", hAccBtn).CornerRadius = UDim.new(0, 4)

					local hRejBtn = Instance.new("TextButton")
					hRejBtn.Size = UDim2.new(0, 20, 0, 18)
					hRejBtn.Position = UDim2.new(1, -24, 0.5, -9)
					hRejBtn.BackgroundColor3 = Color3.fromRGB(140, 25, 30)
					hRejBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					hRejBtn.Text = "✗"
					hRejBtn.TextSize = 11
					hRejBtn.Font = Enum.Font.GothamBold
					hRejBtn.BorderSizePixel = 0
					hRejBtn.Parent = hunkSep
					Instance.new("UICorner", hRejBtn).CornerRadius = UDim.new(0, 4)

					local capturedDiffId = diffId
					local capturedHunkId = hunk.id

					local function checkAllResolved()
						local allResolved = true
						for _, h in diffData.hunks do
							if h.status == "pending" then allResolved = false; break end
						end
						if allResolved then
							local hasAccepted = false
							for _, h in diffData.hunks do
								if h.status == "accepted" then hasAccepted = true; break end
							end
							if hasAccepted then
								local finalSource = applyPartialDiff(diffData)
								if finalSource then
									local inst = resolveInstance(diffData.scriptPath)
									if inst and inst:IsA("LuaSourceContainer") then
										ChangeHistoryService:SetWaypoint("LS:apply diff")
										ScriptEditorService:UpdateSourceAsync(inst, function() return finalSource end)
										ChangeHistoryService:SetWaypoint("LS:applied diff")
									end
								end
							end
							archiveDiff(capturedDiffId, diffData)
							diffQueue[capturedDiffId] = nil
						end
						task.defer(renderDiffUI)
					end

					hAccBtn.Activated:Connect(function()
						httpPost("/diff/resolve", { diffId = capturedDiffId, hunkId = capturedHunkId, action = "accept" })
						hunk.status = "accepted"
						checkAllResolved()
					end)
					hRejBtn.Activated:Connect(function()
						httpPost("/diff/resolve", { diffId = capturedDiffId, hunkId = capturedHunkId, action = "reject" })
						hunk.status = "rejected"
						checkAllResolved()
					end)
				elseif hunk.status == "accepted" then
					local badge = Instance.new("TextLabel")
					badge.Size = UDim2.new(0, 60, 0, 18)
					badge.Position = UDim2.new(1, -66, 0.5, -9)
					badge.BackgroundTransparency = 1
					badge.Text = "✓ Accepted"
					badge.TextColor3 = ADD_TEXT
					badge.TextSize = 10
					badge.Font = Enum.Font.GothamBold
					badge.Parent = hunkSep
				elseif hunk.status == "rejected" then
					local badge = Instance.new("TextLabel")
					badge.Size = UDim2.new(0, 60, 0, 18)
					badge.Position = UDim2.new(1, -66, 0.5, -9)
					badge.BackgroundTransparency = 1
					badge.Text = "✗ Rejected"
					badge.TextColor3 = DEL_TEXT
					badge.TextSize = 10
					badge.Font = Enum.Font.GothamBold
					badge.Parent = hunkSep
				end

				pixelOffset += LINE_HEIGHT

			elseif entry.isCollapsed then
				lineOrder += 1
				local collapseBar = Instance.new("TextButton")
				collapseBar.Name = "Collapse_" .. lineOrder
				collapseBar.Size = UDim2.new(1, 0, 0, LINE_HEIGHT)
				collapseBar.BackgroundColor3 = DIFF_HEADER_BG
				collapseBar.BorderSizePixel = 0
				collapseBar.LayoutOrder = lineOrder
				collapseBar.Text = string.format("  ⋯ %d lines hidden ⋯", entry.hiddenCount)
				collapseBar.TextColor3 = GUTTER_TEXT
				collapseBar.TextSize = 11
				collapseBar.Font = Enum.Font.Code
				collapseBar.TextXAlignment = Enum.TextXAlignment.Center
				collapseBar.Parent = diffScroll

				local capturedKey = entry.regionKey
				collapseBar.Activated:Connect(function()
					expandedRegions[capturedKey] = true
					task.defer(renderDiffUI)
				end)

				pixelOffset += LINE_HEIGHT

			else
				lineOrder += 1
				if not firstChangePixelOffset and (entry.type == "add" or entry.type == "del") then
					firstChangePixelOffset = pixelOffset
				end
				local lineRow = createDiffLineRow(entry, lineOrder, entry.hunkIdx ~= nil)
				lineRow.Parent = diffScroll
				pixelOffset += LINE_HEIGHT
			end
		end

		if not globalFirstChangeOffset and firstChangePixelOffset then
			globalFirstChangeOffset = globalPixelOffset + firstChangePixelOffset
		end
		globalPixelOffset += pixelOffset

		-- ═══ Bottom border ═══
		lineOrder += 1
		local bottomBorder = Instance.new("Frame")
		bottomBorder.Size = UDim2.new(1, 0, 0, 1)
		bottomBorder.BackgroundColor3 = DIFF_BORDER
		bottomBorder.BorderSizePixel = 0
		bottomBorder.LayoutOrder = lineOrder
		bottomBorder.Parent = diffScroll

		-- Spacer between files
		lineOrder += 1
		local spacer = Instance.new("Frame")
		spacer.Size = UDim2.new(1, 0, 0, 16)
		spacer.BackgroundTransparency = 1
		spacer.LayoutOrder = lineOrder
		spacer.Parent = diffScroll

		-- ═══ Wire up file-level accept/reject ═══
		local capturedDiffId = diffId
		acceptBtn.Activated:Connect(function()
			httpPost("/diff/resolve", { diffId = capturedDiffId, action = "accept_all" })
			for _, h in diffData.hunks do h.status = "accepted" end
			local inst = resolveInstance(diffData.scriptPath)
			if inst and inst:IsA("LuaSourceContainer") then
				local newSource = reconstructNewSource(diffData)
				if newSource then
					ChangeHistoryService:SetWaypoint("LS:accept all")
					ScriptEditorService:UpdateSourceAsync(inst, function() return newSource end)
					ChangeHistoryService:SetWaypoint("LS:accepted all")
				end
			end
			archiveDiff(capturedDiffId, diffData)
			diffQueue[capturedDiffId] = nil
			showToast("Diff accepted: " .. (diffData.scriptName or diffData.scriptPath or "Script"), "success")
			task.defer(renderDiffUI)
		end)

		rejectBtn.Activated:Connect(function()
			httpPost("/diff/resolve", { diffId = capturedDiffId, action = "reject_all" })
			for _, h in diffData.hunks do h.status = "rejected" end
			archiveDiff(capturedDiffId, diffData)
			diffQueue[capturedDiffId] = nil
			showToast("Diff rejected: " .. (diffData.scriptName or diffData.scriptPath or "Script"), "error")
			task.defer(renderDiffUI)
		end)
	end

	updateDiffBadge()

	-- Auto-scroll to first change
	if globalFirstChangeOffset then
		task.defer(function()
			local scrollY = math.max(0, globalFirstChangeOffset - diffScroll.AbsoluteSize.Y / 3)
			diffScroll.CanvasPosition = Vector2.new(0, scrollY)
		end)
	end
end

-- ============================================================================
-- Request Handlers
-- ============================================================================

local handlers = {}

handlers["get_file_tree"] = function(params)
	local treeRoot = game
	if params.path and params.path ~= "game" then
		for _, segment in string.split(params.path, ".") do
			if segment ~= "game" then
				treeRoot = treeRoot:FindFirstChild(segment)
				if not treeRoot then return { success = false, error = "Path not found: " .. params.path } end
			end
		end
	end
	local function buildTree(inst, depth, maxDepth)
		if maxDepth >= 0 and depth > maxDepth then return nil end
		local node = { name = inst.Name, className = inst.ClassName, children = {} }
		for _, child in inst:GetChildren() do
			local childNode = buildTree(child, depth + 1, maxDepth)
			if childNode then table.insert(node.children, childNode) end
		end
		return node
	end
	return { success = true, data = buildTree(treeRoot, 0, params.depth or -1) }
end

handlers["get_project_structure"] = function()
	local structure = {}
	for _, svc in game:GetChildren() do
		local scriptCount, partCount, totalCount = 0, 0, 0
		local function countDescendants(inst)
			totalCount += 1
			if inst:IsA("LuaSourceContainer") then scriptCount += 1
			elseif inst:IsA("BasePart") then partCount += 1 end
			for _, child in inst:GetChildren() do countDescendants(child) end
		end
		countDescendants(svc)
		table.insert(structure, { name = svc.Name, className = svc.ClassName, childCount = #svc:GetChildren(), totalDescendants = totalCount, scriptCount = scriptCount, partCount = partCount })
	end
	return { success = true, data = structure }
end

handlers["get_place_info"] = function()
	return { success = true, data = { name = game.Name ~= "" and game.Name or "Unnamed Place", placeId = game.PlaceId, gameId = game.GameId, creatorId = game.CreatorId, creatorType = tostring(game.CreatorType) } }
end

handlers["get_services"] = function()
	local services = {}
	for _, svc in game:GetChildren() do
		table.insert(services, { name = svc.Name, className = svc.ClassName, childCount = #svc:GetChildren() })
	end
	return { success = true, data = services }
end

handlers["search_files"] = function(params)
	local results = {}
	local query = string.lower(params.query or "")
	local function search(inst, path)
		local fullPath = path .. "." .. inst.Name
		if string.find(string.lower(inst.Name), query, 1, true) then
			if not params.classFilter or inst.ClassName == params.classFilter then
				table.insert(results, { name = inst.Name, path = fullPath, className = inst.ClassName })
			end
		end
		for _, child in inst:GetChildren() do search(child, fullPath) end
	end
	for _, svc in game:GetChildren() do search(svc, "game") end
	return { success = true, data = results }
end

handlers["search_objects"] = function(params)
	local searchRoot = game
	local rootPath = "game"
	if params.parent then
		searchRoot = resolveInstance(params.parent)
		if not searchRoot then return { success = false, error = "Parent not found: " .. params.parent } end
		rootPath = params.parent
	end
	local results = {}
	local namePattern = params.name and string.lower(params.name) or nil
	local function search(inst, path)
		if #results >= 200 then return end
		local fullPath = path .. "." .. inst.Name
		local match = true
		if namePattern and not string.find(string.lower(inst.Name), namePattern, 1, true) then match = false end
		if params.className and inst.ClassName ~= params.className then match = false end
		if match and (namePattern or params.className) then
			table.insert(results, { name = inst.Name, path = fullPath, className = inst.ClassName })
		end
		for _, child in inst:GetChildren() do search(child, fullPath) end
	end
	for _, child in searchRoot:GetChildren() do search(child, rootPath) end
	return { success = true, data = results }
end

handlers["search_by_property"] = function(params)
	local searchRoot = game
	local rootPath = "game"
	if params.parent then
		searchRoot = resolveInstance(params.parent)
		if not searchRoot then return { success = false, error = "Parent not found: " .. params.parent } end
		rootPath = params.parent
	end
	local results = {}
	local function search(inst, path)
		if #results >= 200 then return end
		local fullPath = path .. "." .. inst.Name
		if not params.className or inst.ClassName == params.className then
			local ok, val = pcall(function() return tostring((inst :: any)[params.propertyName]) end)
			if ok and val == params.propertyValue then
				table.insert(results, { name = inst.Name, path = fullPath, className = inst.ClassName, value = val })
			end
		end
		for _, child in inst:GetChildren() do search(child, fullPath) end
	end
	for _, child in searchRoot:GetChildren() do search(child, rootPath) end
	return { success = true, data = results }
end

handlers["grep_scripts"] = function(params)
	local results = {}
	local contextLines = params.contextLines or 2
	local function searchScript(inst, path)
		if #results >= 100 then return end
		local fullPath = path .. "." .. inst.Name
		if inst:IsA("LuaSourceContainer") then
			if not params.scriptType or inst.ClassName == params.scriptType then
				local ok, source = pcall(function() return ScriptEditorService:GetEditorSource(inst) end)
				if ok and source then
					local lines = string.split(source, "\n")
					for lineNum, line in ipairs(lines) do
						if #results >= 100 then break end
						if string.find(line, params.pattern, 1, not params.useRegex) then
							local ctxBefore, ctxAfter = {}, {}
							for i = math.max(1, lineNum - contextLines), lineNum - 1 do
								table.insert(ctxBefore, { line = i, content = lines[i] })
							end
							for i = lineNum + 1, math.min(#lines, lineNum + contextLines) do
								table.insert(ctxAfter, { line = i, content = lines[i] })
							end
							table.insert(results, { scriptPath = fullPath, scriptName = inst.Name, lineNumber = lineNum, matchLine = line, contextBefore = ctxBefore, contextAfter = ctxAfter })
						end
					end
				end
			end
		end
		for _, child in inst:GetChildren() do searchScript(child, fullPath) end
	end
	for _, svc in game:GetChildren() do searchScript(svc, "game") end
	return { success = true, data = results }
end

handlers["get_class_info"] = function(params)
	local ok, tempInst = pcall(Instance.new, params.className)
	if not ok then return { success = false, error = "Cannot create instance of class: " .. params.className } end
	local info = { className = params.className, properties = {}, isA = {} }
	for _, check in { "BasePart", "GuiObject", "LuaSourceContainer", "ValueBase", "Light", "Constraint", "UIBase", "Model", "Tool", "Humanoid" } do
		local isOk, isResult = pcall(function() return tempInst:IsA(check) end)
		if isOk and isResult then table.insert(info.isA, check) end
	end
	for _, propName in { "Name", "ClassName", "Position", "Size", "CFrame", "BrickColor", "Color", "Material", "Anchored", "CanCollide", "Transparency", "Visible", "Enabled", "Value", "Text", "Font", "TextSize", "Shape", "Reflectance" } do
		local valOk, val = pcall(function() return (tempInst :: any)[propName] end)
		if valOk and val ~= nil then info.properties[propName] = { value = tostring(val), type = typeof(val) } end
	end
	tempInst:Destroy()
	return { success = true, data = info }
end

handlers["mass_get_property"] = function(params)
	local results = {}
	for _, path in params.paths do
		local inst = resolveInstance(path)
		if inst then
			local ok, val = pcall(function() return tostring((inst :: any)[params.propertyName]) end)
			table.insert(results, { path = path, value = ok and val or nil, error = not ok and "Property not readable" or nil })
		else
			table.insert(results, { path = path, error = "Not found" })
		end
	end
	return { success = true, data = results }
end

handlers["get_instance_properties"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found: " .. (params.path or "nil") } end
	local props = {}
	for _, propName in { "Name", "ClassName", "Parent", "Position", "Size", "CFrame", "BrickColor", "Color", "Material", "Anchored", "CanCollide", "Transparency", "Visible", "Enabled", "Value", "Text", "Font", "TextSize", "TextColor3", "BackgroundColor3", "Source", "MaxHealth", "Health", "WalkSpeed", "JumpPower" } do
		local valOk, val = pcall(function() return (inst :: any)[propName] end)
		if valOk and val ~= nil then props[propName] = tostring(val) end
	end
	return { success = true, data = props }
end

handlers["get_instance_children"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found: " .. (params.path or "nil") } end
	local children = {}
	for _, child in inst:GetChildren() do table.insert(children, { name = child.Name, className = child.ClassName }) end
	return { success = true, data = children }
end

handlers["get_selection"] = function()
	local sel = Selection:Get()
	local results = {}
	for _, inst in sel do table.insert(results, { name = inst.Name, className = inst.ClassName, path = getInstancePath(inst) }) end
	return { success = true, data = results }
end

handlers["get_script_source"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Script not found: " .. (params.path or "nil") } end
	if not inst:IsA("LuaSourceContainer") then return { success = false, error = inst.Name .. " is not a script" } end
	local source = ScriptEditorService:GetEditorSource(inst)
	local lines = string.split(source, "\n")
	local numbered = {}
	for i, line in lines do table.insert(numbered, i .. ": " .. line) end
	return { success = true, data = { source = source, numberedSource = table.concat(numbered, "\n"), lineCount = #lines } }
end

handlers["set_script_source_direct"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Script not found: " .. (params.path or "nil") } end
	if not inst:IsA("LuaSourceContainer") then return { success = false, error = inst.Name .. " is not a script" } end
	ChangeHistoryService:SetWaypoint("LS:update " .. inst.Name)
	ScriptEditorService:UpdateSourceAsync(inst, function() return params.source end)
	ChangeHistoryService:SetWaypoint("LS:updated " .. inst.Name)
	return { success = true, data = { message = "Script updated: " .. params.path } }
end

handlers["stage_diff"] = function(params)
	diffQueue[params.diffId] = params
	task.defer(function()
		renderDiffUI()
		diffWidget.Enabled = true -- Auto-open diff window
	end)
	return { success = true, data = { message = "Diff staged", diffId = params.diffId } }
end

handlers["grep_replace"] = function(params)
	local affected = {}
	local totalReplacements = 0
	local function processScript(inst, path)
		local fullPath = path .. "." .. inst.Name
		if inst:IsA("LuaSourceContainer") then
			if not params.scriptType or inst.ClassName == params.scriptType then
				local ok, source = pcall(function() return ScriptEditorService:GetEditorSource(inst) end)
				if ok and source then
					local newSource, count
					if params.useRegex then
						newSource, count = string.gsub(source, params.find, params.replace)
					else
						local escaped = string.gsub(params.find, "([%(%)%.%%%+%-%*%?%[%]%^%$])", "%%%1")
						newSource, count = string.gsub(source, escaped, params.replace)
					end
					if count > 0 then
						if not params.dryRun then
							ChangeHistoryService:SetWaypoint("LS:grep_replace " .. inst.Name)
							ScriptEditorService:UpdateSourceAsync(inst, function() return newSource end)
							ChangeHistoryService:SetWaypoint("LS:grep_replaced " .. inst.Name)
						end
						table.insert(affected, { scriptPath = fullPath, scriptName = inst.Name, replacements = count })
						totalReplacements += count
					end
				end
			end
		end
		for _, child in inst:GetChildren() do processScript(child, fullPath) end
	end
	for _, svc in game:GetChildren() do processScript(svc, "game") end
	return { success = true, data = { scriptsAffected = #affected, totalReplacements = totalReplacements, dryRun = params.dryRun or false, affected = affected } }
end

handlers["create_object"] = function(params)
	local parent = resolveInstance(params.parent)
	if not parent then return { success = false, error = "Parent not found: " .. params.parent } end
	ChangeHistoryService:SetWaypoint("LS:create " .. params.className)
	local inst = Instance.new(params.className)
	if params.name then inst.Name = params.name end
	if params.properties then
		for prop, val in params.properties do pcall(function() (inst :: any)[prop] = convertValue(val, prop) end) end
	end
	inst.Parent = parent
	ChangeHistoryService:SetWaypoint("LS:created " .. inst.Name)
	return { success = true, data = { name = inst.Name, path = getInstancePath(inst), className = inst.ClassName } }
end

handlers["delete_object"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found: " .. (params.path or "nil") } end
	ChangeHistoryService:SetWaypoint("LS:delete " .. inst.Name)
	inst:Destroy()
	ChangeHistoryService:SetWaypoint("LS:deleted")
	return { success = true, data = { message = "Deleted: " .. params.path } }
end

handlers["set_property"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found: " .. (params.path or "nil") } end
	local oldVal = nil
	pcall(function() oldVal = tostring((inst :: any)[params.property]) end)
	ChangeHistoryService:SetWaypoint("LS:set " .. params.property)
	local ok, err = pcall(function() (inst :: any)[params.property] = convertValue(params.value, params.property) end)
	ChangeHistoryService:SetWaypoint("LS:set " .. params.property)
	if ok then return { success = true, data = { property = params.property, oldValue = oldVal, newValue = tostring(params.value) } }
	else return { success = false, error = "Failed to set property: " .. tostring(err) } end
end

handlers["mass_create_objects"] = function(params)
	ChangeHistoryService:SetWaypoint("LS:mass create start")
	local created, errors = {}, {}
	for i, obj in params.objects do
		local parent = resolveInstance(obj.parent)
		if not parent then table.insert(errors, { index = i, error = "Parent not found: " .. obj.parent }); continue end
		local ok, inst = pcall(function()
			local newInst = Instance.new(obj.className)
			if obj.name then newInst.Name = obj.name end
			if obj.properties then for prop, val in obj.properties do pcall(function() (newInst :: any)[prop] = convertValue(val, prop) end) end end
			newInst.Parent = parent; return newInst
		end)
		if ok then table.insert(created, { name = inst.Name, path = getInstancePath(inst), className = inst.ClassName })
		else table.insert(errors, { index = i, error = tostring(inst) }) end
	end
	ChangeHistoryService:SetWaypoint("LS:mass create done")
	if #errors > 0 and #created == 0 then return { success = false, error = "All creates failed", data = { errors = errors } } end
	return { success = true, data = { created = created, errors = errors, count = #created } }
end

handlers["mass_set_property"] = function(params)
	ChangeHistoryService:SetWaypoint("LS:mass set property start")
	local updated, errors = 0, {}
	local convertedVal = convertValue(params.value, params.property)
	for _, path in params.paths do
		local inst = resolveInstance(path)
		if not inst then table.insert(errors, { path = path, error = "Not found" }); continue end
		local ok, err = pcall(function() (inst :: any)[params.property] = convertedVal end)
		if ok then updated += 1 else table.insert(errors, { path = path, error = tostring(err) }) end
	end
	ChangeHistoryService:SetWaypoint("LS:mass set property done")
	return { success = true, data = { updated = updated, errors = errors } }
end

handlers["mass_duplicate"] = function(params)
	ChangeHistoryService:SetWaypoint("LS:mass duplicate start")
	local duplicated = {}
	local count = params.count or 1
	local offset = params.offset and Vector3.new(params.offset[1], params.offset[2], params.offset[3]) or nil
	for _, path in params.paths do
		local inst = resolveInstance(path)
		if not inst or not inst.Parent then continue end
		for copyNum = 1, count do
			local clone = inst:Clone()
			clone.Name = inst.Name .. "_copy" .. copyNum
			if offset and clone:IsA("BasePart") then
				pcall(function() clone.Position = (inst :: any).Position + offset * copyNum end)
			elseif offset and clone:IsA("Model") and clone.PrimaryPart then
				pcall(function() clone:PivotTo(inst:GetPivot() * CFrame.new(offset * copyNum)) end)
			end
			clone.Parent = inst.Parent
			table.insert(duplicated, { name = clone.Name, path = getInstancePath(clone) })
		end
	end
	ChangeHistoryService:SetWaypoint("LS:mass duplicate done")
	return { success = true, data = { duplicated = duplicated, count = #duplicated } }
end

handlers["smart_duplicate"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found: " .. (params.path or "nil") } end
	ChangeHistoryService:SetWaypoint("LS:smart duplicate start")
	local results = {}
	local count, spacing, layout = params.count or 1, params.spacing or 5, params.layout or "grid"
	local gridCols = math.ceil(math.sqrt(count))
	for i = 1, count do
		local clone = inst:Clone()
		clone.Name = inst.Name .. "_" .. i
		local offsetPos = Vector3.zero
		if layout == "line" then offsetPos = Vector3.new(spacing * i, 0, 0)
		elseif layout == "grid" then offsetPos = Vector3.new(((i-1) % gridCols) * spacing, 0, math.floor((i-1) / gridCols) * spacing)
		elseif layout == "circle" then local angle = (2 * math.pi * i) / count; offsetPos = Vector3.new(math.cos(angle) * spacing, 0, math.sin(angle) * spacing) end
		if clone:IsA("BasePart") then pcall(function() clone.Position = (inst :: any).Position + offsetPos end)
		elseif clone:IsA("Model") and clone.PrimaryPart then pcall(function() clone:PivotTo(inst:GetPivot() * CFrame.new(offsetPos)) end) end
		clone.Parent = inst.Parent
		table.insert(results, { name = clone.Name, path = getInstancePath(clone), position = { offsetPos.X, offsetPos.Y, offsetPos.Z } })
	end
	ChangeHistoryService:SetWaypoint("LS:smart duplicate done")
	return { success = true, data = { duplicated = results, count = #results } }
end

handlers["set_calculated_property"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found: " .. (params.path or "nil") } end
	local ok, currentVal = pcall(function() return (inst :: any)[params.property] end)
	if not ok then return { success = false, error = "Cannot read property: " .. params.property } end
	local valType = typeof(currentVal)
	local valStr = valType == "number" and tostring(currentVal) or valType == "Vector3" and string.format("Vector3.new(%f,%f,%f)", currentVal.X, currentVal.Y, currentVal.Z) or tostring(currentVal)
	local code = "local current = " .. valStr .. "; return " .. params.formula
	local fn, compileErr = loadstring(code)
	if not fn then return { success = false, error = "Formula error: " .. tostring(compileErr) } end
	local calcOk, newVal = pcall(fn)
	if not calcOk then return { success = false, error = "Formula runtime error: " .. tostring(newVal) } end
	ChangeHistoryService:SetWaypoint("LS:calculated set " .. params.property)
	local setOk, setErr = pcall(function() (inst :: any)[params.property] = newVal end)
	ChangeHistoryService:SetWaypoint("LS:calculated set done")
	if setOk then return { success = true, data = { property = params.property, oldValue = tostring(currentVal), newValue = tostring(newVal) } }
	else return { success = false, error = "Failed to set: " .. tostring(setErr) } end
end

handlers["execute_luau"] = function(params) return executeLuau(params.code) end
handlers["run_code"] = function(params) return executeLuau(params.code) end
handlers["start_playtest"] = function(params)
	local mode = params and params.mode or "play"
	if RunService:IsRunning() then return { success = false, error = "A playtest is already running. Stop it first." } end
	playtestLogs = {}
	playtestStartTime = os.clock()
	if logConnection then logConnection:Disconnect() end
	logConnection = LogService.MessageOut:Connect(function(message, messageType)
		table.insert(playtestLogs, {
			type = if messageType == Enum.MessageType.MessageError then "error"
				elseif messageType == Enum.MessageType.MessageWarning then "warning"
				else "output",
			message = message,
			timestamp = os.clock() - playtestStartTime,
		})
	end)
	local VIM = game:GetService("VirtualInputManager")
	if mode == "run" then
		VIM:SendKeyEvent(true, Enum.KeyCode.F8, false, game)
		task.wait(0.05)
		VIM:SendKeyEvent(false, Enum.KeyCode.F8, false, game)
	else
		VIM:SendKeyEvent(true, Enum.KeyCode.F5, false, game)
		task.wait(0.05)
		VIM:SendKeyEvent(false, Enum.KeyCode.F5, false, game)
	end
	local elapsed = 0
	while not RunService:IsRunning() and elapsed < 5 do task.wait(0.1); elapsed += 0.1 end
	if not RunService:IsRunning() then
		if logConnection then logConnection:Disconnect(); logConnection = nil end
		return { success = false, error = "Failed to start playtest — Studio did not enter " .. mode .. " mode after 5 seconds." }
	end
	pluginState = "playtesting"
	return { success = true, data = { message = "Playtest started in " .. mode .. " mode" } }
end

handlers["stop_playtest"] = function()
	if not RunService:IsRunning() and not RunService:IsRunMode() then
		return { success = false, error = "No playtest is running." }
	end
	local duration = os.clock() - playtestStartTime
	local VIM = game:GetService("VirtualInputManager")
	VIM:SendKeyEvent(true, Enum.KeyCode.F5, true, game)
	task.wait(0.05)
	VIM:SendKeyEvent(false, Enum.KeyCode.F5, true, game)
	local elapsed = 0
	while RunService:IsRunning() and elapsed < 5 do task.wait(0.1); elapsed += 0.1 end
	if logConnection then logConnection:Disconnect(); logConnection = nil end
	local errors = {}
	for _, log in playtestLogs do
		if log.type == "error" then table.insert(errors, log.message) end
	end
	local output = playtestLogs
	playtestLogs = {}
	pluginState = "idle"
	return { success = true, data = { output = output, errors = errors, duration = duration } }
end

handlers["get_playtest_output"] = function(params)
	local since = params and params.since or 0
	local filtered = {}
	for _, log in playtestLogs do
		if log.timestamp > since then table.insert(filtered, log) end
	end
	return { success = true, data = { logs = filtered, isRunning = RunService:IsRunning() } }
end

handlers["run_script_in_play_mode"] = function(params)
	if not params or not params.code then return { success = false, error = "Missing required parameter: code" } end
	local wasRunning = RunService:IsRunning()
	if not wasRunning then
		local startResult = handlers["start_playtest"]({ mode = params.mode or "run" })
		if not startResult.success then return startResult end
		task.wait(1)
	end
	local result = executeLuau(params.code)
	local timeout = params.timeout or 30
	task.wait(math.min(timeout, 1))
	local stopResult = handlers["stop_playtest"]()
	return {
		success = result.success,
		data = {
			output = result.data and result.data.output or "",
			errors = stopResult.data and stopResult.data.errors or {},
			duration = stopResult.data and stopResult.data.duration or 0,
		},
	}
end

handlers["user_keyboard_input"] = function(params)
	if not RunService:IsRunning() then return { success = false, error = "Keyboard input requires an active play session." } end
	if not params or not params.key then return { success = false, error = "Missing required parameter: key" } end
	local key = params.key
	local action = params.action or "press"
	local duration = params.duration or 100
	local code
	if action == "press" then
		code = string.format("local VIM=game:GetService('VirtualInputManager') VIM:SendKeyEvent(true,Enum.KeyCode.%s,false,game) task.wait(0.05) VIM:SendKeyEvent(false,Enum.KeyCode.%s,false,game) print('Key pressed: %s')", key, key, key)
	elseif action == "hold" then
		code = string.format("local VIM=game:GetService('VirtualInputManager') VIM:SendKeyEvent(true,Enum.KeyCode.%s,false,game) task.wait(%f) VIM:SendKeyEvent(false,Enum.KeyCode.%s,false,game) print('Key held: %s for %dms')", key, duration / 1000, key, key, duration)
	elseif action == "release" then
		code = string.format("local VIM=game:GetService('VirtualInputManager') VIM:SendKeyEvent(false,Enum.KeyCode.%s,false,game) print('Key released: %s')", key, key)
	else
		return { success = false, error = "Invalid action: " .. tostring(action) }
	end
	return executeLuau(code)
end

handlers["user_mouse_input"] = function(params)
	if not RunService:IsRunning() then return { success = false, error = "Mouse input requires an active play session." } end
	local action = params.action or "click"
	local x, y = params.x or 0, params.y or 0
	local buttonNum = if params.button == "right" then 1 elseif params.button == "middle" then 2 else 0
	local code
	if action == "click" then
		code = string.format("local VIM=game:GetService('VirtualInputManager') VIM:SendMouseButtonEvent(%d,%d,%d,true,game,0) task.wait(0.05) VIM:SendMouseButtonEvent(%d,%d,%d,false,game,0) print('Mouse clicked at %d,%d')", x, y, buttonNum, x, y, buttonNum, x, y)
	elseif action == "move" then
		code = string.format("local VIM=game:GetService('VirtualInputManager') VIM:SendMouseMoveEvent(%d,%d,game) print('Mouse moved to %d,%d')", x, y, x, y)
	elseif action == "scroll" then
		code = string.format("local VIM=game:GetService('VirtualInputManager') VIM:SendMouseWheelEvent(%d,%d,true,game) print('Mouse scrolled at %d,%d')", x, y, x, y)
	else
		return { success = false, error = "Invalid action: " .. tostring(action) }
	end
	return executeLuau(code)
end

handlers["character_navigation"] = function(params)
	if not RunService:IsRunning() then return { success = false, error = "Character navigation requires an active play session." } end
	local targetPos
	if type(params.target) == "table" then targetPos = Vector3.new(params.target[1], params.target[2], params.target[3])
	else
		local target = resolveInstance(tostring(params.target))
		if not target then return { success = false, error = "Target not found" } end
		local posOk, pos = pcall(function() return (target :: any).Position end)
		if not posOk then return { success = false, error = "Target has no Position" } end
		targetPos = pos
	end
	return executeLuau(string.format("local PathfindingService=game:GetService('PathfindingService') local Players=game:GetService('Players') local char=Players.LocalPlayer and Players.LocalPlayer.Character if not char then print('ERROR:No character') return end local humanoid=char:FindFirstChildOfClass('Humanoid') if not humanoid then print('ERROR:No humanoid') return end local path=PathfindingService:CreatePath() path:ComputeAsync(char.PrimaryPart.Position,Vector3.new(%f,%f,%f)) if path.Status==Enum.PathStatus.Success then for _,wp in path:GetWaypoints() do humanoid:MoveTo(wp.Position) humanoid.MoveToFinished:Wait() end print('REACHED') else print('ERROR:Path failed') end", targetPos.X, targetPos.Y, targetPos.Z))
end

handlers["get_studio_mode"] = function()
	local mode = "edit"
	if RunService:IsRunning() then mode = RunService:IsServer() and "server" or "play" end
	return { success = true, data = { mode = mode } }
end

handlers["rollback"] = function(params)
	local count = params.count or 1
	for _ = 1, count do ChangeHistoryService:Undo() end
	return { success = true, data = { message = "Rolled back " .. count .. " step(s)" } }
end

handlers["get_tags"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Not found" } end
	return { success = true, data = CollectionService:GetTags(inst) }
end

handlers["get_tagged"] = function(params)
	local tagged = CollectionService:GetTagged(params.tag)
	local results = {}
	for _, inst in tagged do table.insert(results, { name = inst.Name, path = getInstancePath(inst), className = inst.ClassName }) end
	return { success = true, data = results }
end

handlers["get_attribute"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found" } end
	local val = inst:GetAttribute(params.name)
	if val == nil then return { success = false, error = "Attribute not found: " .. params.name } end
	return { success = true, data = { name = params.name, value = tostring(val), type = typeof(val) } }
end

handlers["get_attributes"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found" } end
	local attrs = inst:GetAttributes()
	local result = {}
	for name, val in attrs do result[name] = { value = tostring(val), type = typeof(val) } end
	return { success = true, data = result }
end

handlers["capture_screenshot"] = function()
	-- Graceful degradation: try to capture, fall back to camera info
	local camera = workspace.CurrentCamera
	if not camera then return { success = false, error = "No active camera" } end
	local info = {
		position = { camera.CFrame.Position.X, camera.CFrame.Position.Y, camera.CFrame.Position.Z },
		lookVector = { camera.CFrame.LookVector.X, camera.CFrame.LookVector.Y, camera.CFrame.LookVector.Z },
		fieldOfView = camera.FieldOfView,
		viewportSize = { camera.ViewportSize.X, camera.ViewportSize.Y },
	}
	-- Try pixel capture via EditableImage (Studio 2024.2+)
	local ok, imgData = pcall(function()
		local size = Vector2.new(320, 240)
		local img = Instance.new("EditableImage")
		img.Size = size
		local vf = Instance.new("ViewportFrame")
		vf.Size = UDim2.fromOffset(320, 240)
		vf.CurrentCamera = camera
		vf.Parent = CoreGui
		task.wait(0.1)
		local pixels = img:ReadPixels(Vector2.zero, size)
		vf:Destroy()
		img:Destroy()
		return pixels
	end)
	if ok and imgData then
		info.pixelData = "captured"
		info.resolution = { 320, 240 }
	else
		info.pixelData = nil
		info.note = "Pixel capture unavailable — returning camera metadata only"
		-- Add visible objects in view
		local visibleObjects = {}
		for _, obj in workspace:GetChildren() do
			if obj:IsA("BasePart") or obj:IsA("Model") then
				table.insert(visibleObjects, { name = obj.Name, className = obj.ClassName })
			end
		end
		info.visibleObjects = visibleObjects
	end
	return { success = true, data = info }
end

handlers["export_build"] = function(params)
	local inst = resolveInstance(params.path)
	if not inst then return { success = false, error = "Instance not found" } end
	local function serialize(obj)
		local node = { className = obj.ClassName, name = obj.Name, properties = {}, children = {} }
		for _, p in { "Position", "Size", "CFrame", "Color", "BrickColor", "Material", "Anchored", "CanCollide", "Transparency", "Visible", "Value", "Text" } do
			local ok, v = pcall(function() return (obj :: any)[p] end)
			if ok and v ~= nil then node.properties[p] = tostring(v) end
		end
		if obj:IsA("LuaSourceContainer") then
			local srcOk, src = pcall(function() return ScriptEditorService:GetEditorSource(obj) end)
			if srcOk then node.properties["Source"] = src end
		end
		for _, child in obj:GetChildren() do table.insert(node.children, serialize(child)) end
		return node
	end
	local buildData = serialize(inst)
	local library = plugin:GetSetting("LSBuildLibrary") or {}
	library[params.name] = { data = buildData, description = params.description or "", timestamp = os.time(), instanceCount = #inst:GetDescendants() + 1 }
	local saveOk = pcall(function() plugin:SetSetting("LSBuildLibrary", library) end)
	if not saveOk then return { success = false, error = "Failed to save — data may be too large." } end
	return { success = true, data = { buildId = params.name, name = params.name, instanceCount = #inst:GetDescendants() + 1 } }
end

handlers["import_build"] = function(params)
	local library = plugin:GetSetting("LSBuildLibrary") or {}
	local entry = library[params.name]
	if not entry then return { success = false, error = "Build not found: " .. params.name } end
	local parentPath = params.parent or "game.Workspace"
	local parent = resolveInstance(parentPath)
	if not parent then return { success = false, error = "Parent not found: " .. parentPath } end
	ChangeHistoryService:SetWaypoint("LS:import build " .. params.name)
	local function reconstruct(data, parentInst)
		local ok, inst = pcall(Instance.new, data.className)
		if not ok then return nil end
		inst.Name = data.name
		for prop, val in data.properties do pcall(function() (inst :: any)[prop] = val end) end
		inst.Parent = parentInst
		for _, childData in data.children do reconstruct(childData, inst) end
		return inst
	end
	local importedRoot = reconstruct(entry.data, parent)
	ChangeHistoryService:SetWaypoint("LS:imported build " .. params.name)
	if importedRoot then return { success = true, data = { name = importedRoot.Name, path = getInstancePath(importedRoot) } }
	else return { success = false, error = "Failed to reconstruct build" } end
end

handlers["list_library"] = function()
	local library = plugin:GetSetting("LSBuildLibrary") or {}
	local results = {}
	for name, entry in library do table.insert(results, { name = name, description = entry.description, instanceCount = entry.instanceCount, timestamp = entry.timestamp }) end
	return { success = true, data = results }
end

handlers["insert_model"] = function(params)
	ChangeHistoryService:SetWaypoint("LS:insert model")
	local ok, model = pcall(function() return InsertService:LoadAsset(params.assetId) end)
	if not ok then return { success = false, error = "Failed to load asset: " .. tostring(model) } end
	local firstName = "Model"
	for _, child in model:GetChildren() do firstName = child.Name; child.Parent = game.Workspace end
	model:Destroy()
	ChangeHistoryService:SetWaypoint("LS:inserted model")
	return { success = true, data = { name = firstName, path = "game.Workspace." .. firstName } }
end

